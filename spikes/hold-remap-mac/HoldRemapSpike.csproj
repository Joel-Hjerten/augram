<Project Sdk="Microsoft.NET.Sdk">

  <!-- Throwaway spike for plan 0002 step 0 (hold remaps on macOS). Not part of Augram.slnx, so CI never builds it.
       Installs a global hook that suppresses input: only Joel runs it (CLAUDE.md). See README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- LibraryImport's generated marshalling for the CoreGraphics / objc calls in Native.cs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpHook" />
  </ItemGroup>

</Project>
