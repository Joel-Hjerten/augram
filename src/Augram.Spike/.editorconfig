# The spike is throwaway code written before the repo style rules existed (CLAUDE.md).
# Analyzer and style diagnostics are off here so it builds and `dotnet format` leaves it alone.
[*.cs]
dotnet_analyzer_diagnostic.severity = none
dotnet_diagnostic.IDE0005.severity = none
dotnet_diagnostic.IDE0011.severity = none
dotnet_diagnostic.IDE0040.severity = none
dotnet_diagnostic.IDE0161.severity = none
dotnet_diagnostic.IDE1006.severity = none

# Whitespace rule the spike predates; kept as written.
csharp_preserve_single_line_statements = true
