<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Augram.App.App"
             RequestedThemeVariant="Dark">
  <!-- Fluent supplies templates for the standard controls; the Augram theme (ThemeSelector.Active) is added in App.Initialize on top of it. -->
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
</Application>
