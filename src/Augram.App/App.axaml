<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Augram.App.App"
             RequestedThemeVariant="Dark">
  <!-- Fluent supplies templates for the standard controls; the Augram theme (ThemeSelector.Active) is added in App.Initialize on top of it. -->
  <Application.Styles>
    <FluentTheme />
    <!-- Templates for ColorView, the picker a colour field's swatch opens (Components/Fields/Color). -->
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    <!-- Every window (main, training, dialogs) shows the app icon in its title bar, the taskbar and Alt+Tab. Generated by tools/IconTool. -->
    <Style Selector="Window">
      <Setter Property="Icon" Value="/Assets/Icons/augram-256.png" />
    </Style>
  </Application.Styles>
</Application>
