<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:Augram.App.Components.Shell"
        xmlns:host="using:Augram.App.Components.ScreenHost"
        xmlns:form="using:Augram.App.Components.SectionForm"
        xmlns:list="using:Augram.App.Components.ItemList"
        xmlns:text="using:Augram.App.Components.TextPanel"
        xmlns:color="using:Augram.App.Components.Fields.Color"
        xmlns:glyph="using:Augram.App.Components.GestureGlyph"
        xmlns:grid="using:Augram.App.Components.GestureGrid"
        xmlns:draw="using:Augram.App.Components.GestureDrawArea"
        xmlns:bench="using:Augram.App.Components.CommandsWorkbench"
        xmlns:tree="using:Augram.App.Components.CommandTree"
        xmlns:steps="using:Augram.App.Components.StepList"
        xmlns:picker="using:Augram.App.Components.StepTypePicker"
        xmlns:gpicker="using:Augram.App.Components.GesturePicker"
        xmlns:dialog="using:Augram.App.Components.FormDialog"
        xmlns:md="using:Augram.App.Components.MasterDetail">
  <!--
    Wireframe theme (ADR-0002 §5b): grey boxes, 1 px borders, system font, text where icons would go.
    Every lookless component's ControlTheme lives here; Tokens.axaml supplies the values. Replacing the
    look means writing another file like this one and pointing ThemeSelector at it.
  -->
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Augram.App/Themes/Tokens.axaml" />
        <ResourceInclude Source="avares://Augram.App/Themes/Wireframe/Hotkey.axaml" />
        <ResourceInclude Source="avares://Augram.App/Themes/Wireframe/Sync.axaml" />
        <ResourceInclude Source="avares://Augram.App/Themes/Wireframe/WindowFinder.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <ControlTheme x:Key="{x:Type shell:Shell}" TargetType="shell:Shell">
        <Setter Property="Background" Value="{StaticResource Brush.Background}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{TemplateBinding Background}">
              <TabControl Name="PART_Tabs" ItemsSource="{TemplateBinding Tabs}" Padding="{StaticResource Pad.M}" />
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type host:ScreenHost}" TargetType="host:ScreenHost">
        <Setter Property="Template">
          <ControlTemplate>
            <ContentPresenter Content="{TemplateBinding Content}" />
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type form:SectionForm}" TargetType="form:SectionForm">
        <Setter Property="Template">
          <ControlTemplate>
            <ScrollViewer>
              <ItemsControl ItemsSource="{TemplateBinding Sections}" Margin="{StaticResource Pad.S}" />
            </ScrollViewer>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type form:SectionView}" TargetType="form:SectionView">
        <Setter Property="Template">
          <ControlTemplate>
            <Border BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="{StaticResource Border.Hairline}"
                    Background="{StaticResource Brush.Surface}"
                    Padding="{StaticResource Pad.M}"
                    Margin="{StaticResource Pad.S}">
              <StackPanel Spacing="{StaticResource Space.S}">
                <TextBlock Classes="section-title" Text="{TemplateBinding Title}" />
                <TextBlock Classes="help" Text="{TemplateBinding Help}" IsVisible="{TemplateBinding HasHelp}" />
                <ItemsControl ItemsSource="{TemplateBinding Rows}" />
              </StackPanel>
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type form:FieldRow}" TargetType="form:FieldRow">
        <Setter Property="Template">
          <ControlTemplate>
            <Border BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="{StaticResource Border.Bottom}"
                    Padding="{StaticResource Pad.S}">
              <Grid ColumnDefinitions="220,Auto,*">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Classes="field-label" Text="{TemplateBinding Label}" />
                  <TextBlock Classes="help" Text="{TemplateBinding Help}" IsVisible="{TemplateBinding HasHelp}" />
                </StackPanel>
                <!-- The field's accessory (a window finder's magnifier) before the editor; no room taken without one. -->
                <ContentPresenter Grid.Column="1"
                                  Content="{TemplateBinding Accessory}"
                                  IsVisible="{TemplateBinding HasAccessory}"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center" />
                <ContentPresenter Grid.Column="2"
                                  Name="PART_Editor"
                                  Content="{TemplateBinding Editor}"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center" />
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type list:ItemList}" TargetType="list:ItemList">
        <Setter Property="Template">
          <ControlTemplate>
            <Border BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="{StaticResource Border.Hairline}"
                    Background="{StaticResource Brush.Surface}"
                    Margin="{StaticResource Pad.S}">
              <DockPanel>
                <Border DockPanel.Dock="Top"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="{StaticResource Border.Bottom}"
                        Padding="{StaticResource Pad.S}">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.M}">
                    <TextBlock Classes="section-title" Text="{TemplateBinding Title}" VerticalAlignment="Center" />
                    <ItemsControl ItemsSource="{TemplateBinding ToolbarItems}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.S}" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>
                  </StackPanel>
                </Border>
                <Border DockPanel.Dock="Top"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="{StaticResource Border.Bottom}"
                        Padding="{StaticResource Pad.S}">
                  <ContentPresenter Content="{TemplateBinding HeaderRow}" />
                </Border>
                <ListBox Name="PART_Rows"
                         ItemsSource="{TemplateBinding Rows}"
                         ItemTemplate="{TemplateBinding RowTemplate}"
                         Background="{StaticResource Brush.Surface}" />
              </DockPanel>
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type text:TextPanel}" TargetType="text:TextPanel">
        <Setter Property="Template">
          <ControlTemplate>
            <Border Padding="{StaticResource Pad.L}">
              <TextBlock Text="{TemplateBinding Text}" TextWrapping="Wrap" Foreground="{StaticResource Brush.Text}" />
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type color:ColorEditor}" TargetType="color:ColorEditor">
        <Setter Property="Template">
          <ControlTemplate>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.S}">
              <!-- The swatch is Avalonia's ColorPicker: click it for the picker, laid out by its own theme (ColorEditor wires PART_Picker). -->
              <ColorPicker Name="PART_Picker"
                           IsAlphaEnabled="False"
                           IsAlphaVisible="False"
                           IsColorPaletteVisible="False"
                           ToolTip.Tip="Pick a colour" />
              <TextBlock Classes="help" Text="R" VerticalAlignment="Center" />
              <NumericUpDown Name="PART_Red" Classes="channel" Minimum="0" Maximum="255" Increment="1" FormatString="0" />
              <TextBlock Classes="help" Text="G" VerticalAlignment="Center" />
              <NumericUpDown Name="PART_Green" Classes="channel" Minimum="0" Maximum="255" Increment="1" FormatString="0" />
              <TextBlock Classes="help" Text="B" VerticalAlignment="Center" />
              <NumericUpDown Name="PART_Blue" Classes="channel" Minimum="0" Maximum="255" Increment="1" FormatString="0" />
            </StackPanel>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <!-- Gestures tab (M1 step 7): glyph, tile, grid and the training draw area. -->
      <ControlTheme x:Key="{x:Type glyph:GestureGlyph}" TargetType="glyph:GestureGlyph">
        <Setter Property="Width" Value="64" />
        <Setter Property="Height" Value="64" />
        <Setter Property="Padding" Value="{StaticResource Pad.M}" />
        <Setter Property="ArrowLength" Value="8" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="{StaticResource Border.Hairline}">
              <glyph:GlyphStroke Name="PART_Stroke"
                                 Points="{TemplateBinding StrokePoints}"
                                 ArrowLength="{TemplateBinding ArrowLength}"
                                 StartBrush="{DynamicResource Brush.GlyphStart}"
                                 Stroke="{DynamicResource Brush.Glyph}"
                                 StrokeThickness="2" />
            </Border>
          </ControlTemplate>
        </Setter>
        <!-- Start to finish, shaded start to the trail colour (Joel, 2026-10-08; Themes/GlyphColourLink): direction reads along the whole stroke. Inactive: greys. -->
        <Style Selector="^:inactive /template/ glyph|GlyphStroke#PART_Stroke">
          <Setter Property="StartBrush" Value="{StaticResource Brush.GlyphStartMuted}" />
          <Setter Property="Stroke" Value="{StaticResource Brush.TextMuted}" />
        </Style>
        <!-- A thumbnail inside a list row (Diagnostics › Recognition, the command tree): smaller, lighter arrow, tight padding. -->
        <Style Selector="^.row-glyph">
          <Setter Property="Width" Value="{StaticResource Row.GlyphSize}" />
          <Setter Property="Height" Value="{StaticResource Row.GlyphSize}" />
          <Setter Property="Padding" Value="{StaticResource Pad.S}" />
          <Setter Property="ArrowLength" Value="5" />
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type grid:GestureTile}" TargetType="grid:GestureTile">
        <Setter Property="Width" Value="96" />
        <Setter Property="Margin" Value="{StaticResource Pad.S}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="PART_Frame"
                    Padding="{StaticResource Pad.S}"
                    BorderBrush="{StaticResource Brush.Surface}"
                    BorderThickness="{StaticResource Border.Strong}">
              <StackPanel Spacing="{StaticResource Space.S}">
                <Panel HorizontalAlignment="Center">
                  <glyph:GestureGlyph Points="{TemplateBinding Points}" IsActive="{TemplateBinding IsActive}" />
                  <!-- Partner score sits over the glyph's centre so the grid never reflows. -->
                  <Border Classes="tile-partner"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          IsVisible="{TemplateBinding PartnerScoreText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Name="PART_Partner" Classes="tile-partner" Text="{TemplateBinding PartnerScoreText}" />
                  </Border>
                </Panel>
                <TextBlock Name="PART_Name"
                           Classes="tile-name"
                           Text="{TemplateBinding NameText}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           IsVisible="{TemplateBinding IsEditing, Converter={x:Static BoolConverters.Not}}" />
                <TextBox Name="PART_NameEditor" Classes="tile-editor" IsVisible="{TemplateBinding IsEditing}" />
              </StackPanel>
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:inactive /template/ TextBlock#PART_Name">
          <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        </Style>
        <!-- A7: duplicates are outlined and light up with their score when one of them is selected. The frame thickness never changes, only its colour, so marking a partner cannot shift the grid. -->
        <Style Selector="^:duplicate /template/ Border#PART_Frame">
          <Setter Property="BorderBrush" Value="{StaticResource Brush.Danger}" />
        </Style>
        <Style Selector="^:partner /template/ Border#PART_Frame">
          <Setter Property="BorderBrush" Value="{StaticResource Brush.Danger}" />
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type grid:GestureGrid}" TargetType="grid:GestureGrid">
        <Setter Property="Template">
          <ControlTemplate>
            <Border BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="{StaticResource Border.Hairline}"
                    Background="{StaticResource Brush.Surface}"
                    Margin="{StaticResource Pad.S}">
              <DockPanel>
                <Border DockPanel.Dock="Top"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="{StaticResource Border.Bottom}"
                        Padding="{StaticResource Pad.S}">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.S}">
                    <TextBlock Classes="section-title" Text="Gestures" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Name="PART_New" Classes="toolbar" Content="Add new gesture…" />
                    <Button Name="PART_Import" Classes="toolbar" Content="Import from StrokesPlus.net…" />
                    <Button Name="PART_Undo" Classes="toolbar" Content="Undo" IsEnabled="{TemplateBinding CanUndo}" />
                    <Button Name="PART_Redo" Classes="toolbar" Content="Redo" IsEnabled="{TemplateBinding CanRedo}" />
                  </StackPanel>
                </Border>
                <Border DockPanel.Dock="Bottom"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="0,1,0,0"
                        Padding="{StaticResource Pad.S}">
                  <StackPanel Spacing="{StaticResource Space.XS}">
                    <TextBlock Classes="note" Text="{TemplateBinding Message}" IsVisible="{TemplateBinding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Classes="help" Text="Right-click a tile for the menu. Rename in place with the rename key; Delete removes without asking and Undo brings it back." />
                  </StackPanel>
                </Border>
                <ListBox Name="PART_Tiles"
                         ItemsSource="{TemplateBinding TileControls}"
                         Background="{StaticResource Brush.Surface}"
                         SelectionMode="Single">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                </ListBox>
              </DockPanel>
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type draw:GestureDrawArea}" TargetType="draw:GestureDrawArea">
        <Setter Property="MinHeight" Value="240" />
        <Setter Property="ArrowLength" Value="14" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{StaticResource Brush.Background}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="{StaticResource Border.Hairline}"
                    ClipToBounds="True">
              <Panel>
                <TextBlock Name="PART_Hint"
                           Classes="help"
                           Text="Draw here"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsVisible="False" />
                <Path Name="PART_Stroke"
                      Data="{TemplateBinding Geometry}"
                      Stroke="{StaticResource Brush.Accent}"
                      StrokeThickness="4"
                      StrokeLineCap="Round"
                      StrokeJoin="Round" />
              </Panel>
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:empty /template/ TextBlock#PART_Hint">
          <Setter Property="IsVisible" Value="True" />
        </Style>
      </ControlTheme>

      <!-- Commands tab (M2): the workbench lays the tree beside the header and step list; moving the step panel is a change here only. -->
      <ControlTheme x:Key="{x:Type bench:CommandsWorkbench}" TargetType="bench:CommandsWorkbench">
        <Setter Property="Template">
          <ControlTemplate>
            <DockPanel>
              <Border DockPanel.Dock="Bottom"
                      BorderBrush="{StaticResource Brush.Border}"
                      BorderThickness="0,1,0,0"
                      Padding="{StaticResource Pad.S}"
                      Margin="{StaticResource Pad.S}"
                      IsVisible="{TemplateBinding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Classes="note" Text="{TemplateBinding Message}" TextWrapping="Wrap" />
              </Border>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="{StaticResource Workbench.TreeWidth}" MinWidth="240" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" MinWidth="240" />
                </Grid.ColumnDefinitions>
                <tree:CommandTree Name="PART_Tree"
                                  Grid.Column="0"
                                  Sections="{TemplateBinding Sections}"
                                  SelectedSectionId="{TemplateBinding SelectedSectionId}"
                                  SelectedCommandId="{TemplateBinding SelectedCommandId}"
                                  Heading="{TemplateBinding TreeHeading}"
                                  NewSectionLabel="{TemplateBinding NewSectionLabel}"
                                  PlatformFilterLabel="{TemplateBinding PlatformFilterLabel}"
                                  ShowsOtherPlatforms="{TemplateBinding ShowsOtherPlatforms}"
                                  HelpText="{TemplateBinding TreeHelp}" />
                <GridSplitter Grid.Column="1" Width="4" Background="{StaticResource Brush.Border}" ResizeDirection="Columns" />
                <Panel Grid.Column="2">
                  <DockPanel IsVisible="{TemplateBinding ShowsCommandPanel}">
                    <tree:CommandHeader Name="PART_Header" DockPanel.Dock="Top" Item="{TemplateBinding SelectedCommand}" />
                    <steps:StepList Name="PART_Steps"
                                    Steps="{TemplateBinding Steps}"
                                    SelectedIndex="{TemplateBinding SelectedStepIndex}"
                                    StepTypes="{TemplateBinding StepTypes}"
                                    HasCommand="{TemplateBinding HasCommand}" />
                  </DockPanel>
                  <form:SectionForm Name="PART_GroupForm"
                                    Screen="{TemplateBinding GroupForm}"
                                    IsVisible="{TemplateBinding HasGroupForm}" />
                </Panel>
              </Grid>
            </DockPanel>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type tree:CommandTree}" TargetType="tree:CommandTree">
        <Setter Property="Template">
          <ControlTemplate>
            <Border BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="{StaticResource Border.Hairline}"
                    Background="{StaticResource Brush.Surface}"
                    Margin="{StaticResource Pad.S}">
              <DockPanel>
                <Border DockPanel.Dock="Top"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="{StaticResource Border.Bottom}"
                        Padding="{StaticResource Pad.S}">
                  <StackPanel Spacing="{StaticResource Space.S}">
                    <TextBlock Classes="section-title" Text="{TemplateBinding Heading}" />
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.S}">
                      <Button Name="PART_NewSection" Classes="toolbar" Content="{TemplateBinding NewSectionLabel}" />
                      <Button Name="PART_NewCommand" Classes="toolbar" Content="New command" />
                      <ToggleButton Name="PART_OtherPlatforms"
                                    Classes="toolbar"
                                    Content="{TemplateBinding PlatformFilterLabel}"
                                    IsVisible="{TemplateBinding PlatformFilterLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
                <Border DockPanel.Dock="Bottom"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="0,1,0,0"
                        Padding="{StaticResource Pad.S}"
                        IsVisible="{TemplateBinding HelpText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Classes="help" Text="{TemplateBinding HelpText}" />
                </Border>
                <ListBox Name="PART_Rows"
                         ItemsSource="{TemplateBinding Rows}"
                         Background="{StaticResource Brush.Surface}"
                         SelectionMode="Single">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                </ListBox>
              </DockPanel>
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <!-- A section header: an app group (Apps tab) or a category / Uncategorized (Global tab). The active box shows only when the item allows it. -->
      <ControlTheme x:Key="{x:Type tree:SectionRow}" TargetType="tree:SectionRow">
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="PART_Frame" Classes="row">
              <Grid Classes="row-line" ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Name="PART_Expander" Classes="expander" Content="−" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource Space.M}" VerticalAlignment="Center">
                  <TextBlock Name="PART_Name"
                             Classes="group-name"
                             Text="{TemplateBinding NameText}"
                             VerticalAlignment="Center"
                             IsVisible="{TemplateBinding IsEditing, Converter={x:Static BoolConverters.Not}}" />
                  <TextBox Name="PART_NameEditor" Classes="tile-editor" IsVisible="{TemplateBinding IsEditing}" />
                  <TextBlock Classes="help" Text="{TemplateBinding CountText}" VerticalAlignment="Center" />
                </StackPanel>
                <CheckBox Grid.Column="2"
                          Name="PART_Active"
                          Classes="row-active"
                          VerticalAlignment="Center"
                          IsVisible="{TemplateBinding CanToggleActive}" />
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:collapsed /template/ Button#PART_Expander">
          <Setter Property="Content" Value="+" />
        </Style>
        <Style Selector="^:inactive /template/ TextBlock#PART_Name">
          <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        </Style>
        <Style Selector="^:pinned /template/ TextBlock#PART_Name">
          <Setter Property="FontStyle" Value="Italic" />
        </Style>
        <Style Selector="^:elsewhere">
          <Setter Property="Opacity" Value="0.55" />
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type tree:CommandRow}" TargetType="tree:CommandRow">
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="PART_Frame" Classes="row">
              <Grid Classes="row-line indented" ColumnDefinitions="Auto,*,Auto,Auto">
                <Panel Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center">
                  <glyph:GestureGlyph Classes="row-glyph"
                                      Points="{TemplateBinding Points}"
                                      IsActive="{TemplateBinding IsActive}"
                                      IsVisible="{TemplateBinding HasGlyph}" />
                  <Border Classes="trigger-badge" IsVisible="{TemplateBinding HasGlyph, Converter={x:Static BoolConverters.Not}}">
                    <Viewbox StretchDirection="DownOnly">
                      <TextBlock Classes="trigger-badge" Text="{TemplateBinding BadgeText}" />
                    </Viewbox>
                  </Border>
                </Panel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{StaticResource Space.XS}">
                  <StackPanel Orientation="Horizontal"
                              Spacing="{StaticResource Space.M}"
                              IsVisible="{TemplateBinding IsEditing, Converter={x:Static BoolConverters.Not}}">
                    <TextBlock Name="PART_Name" Classes="row-name" Text="{TemplateBinding NameText}" VerticalAlignment="Center" />
                    <Border Classes="category-tag" IsVisible="{TemplateBinding HasCategory}">
                      <TextBlock Classes="category-tag" Text="{TemplateBinding CategoryText}" />
                    </Border>
                  </StackPanel>
                  <TextBox Name="PART_NameEditor" Classes="tile-editor" IsVisible="{TemplateBinding IsEditing}" />
                  <TextBlock Classes="help" Text="{TemplateBinding SummaryText}" />
                </StackPanel>
                <TextBlock Grid.Column="2"
                           Classes="platform-marker"
                           Text="{TemplateBinding MarkerText}"
                           IsVisible="{TemplateBinding HasMarker}"
                           VerticalAlignment="Center" />
                <CheckBox Grid.Column="3" Name="PART_Active" Classes="row-active" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:inactive /template/ TextBlock#PART_Name">
          <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        </Style>
        <Style Selector="^:elsewhere">
          <Setter Property="Opacity" Value="0.55" />
        </Style>
      </ControlTheme>

      <!-- A list beside the selected item's form (the Ignored tab): the Commands tab's look, its column widths and its row metrics. -->
      <ControlTheme x:Key="{x:Type md:MasterDetail}" TargetType="md:MasterDetail">
        <Setter Property="Template">
          <ControlTemplate>
            <DockPanel>
              <Border DockPanel.Dock="Bottom"
                      BorderBrush="{StaticResource Brush.Border}"
                      BorderThickness="0,1,0,0"
                      Padding="{StaticResource Pad.S}"
                      Margin="{StaticResource Pad.S}"
                      IsVisible="{TemplateBinding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Classes="note" Text="{TemplateBinding Message}" TextWrapping="Wrap" />
              </Border>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="{StaticResource Workbench.TreeWidth}" MinWidth="240" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" MinWidth="240" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="{StaticResource Border.Hairline}"
                        Background="{StaticResource Brush.Surface}"
                        Margin="{StaticResource Pad.S}">
                  <DockPanel>
                    <Border DockPanel.Dock="Top"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="{StaticResource Border.Bottom}"
                            Padding="{StaticResource Pad.S}">
                      <StackPanel Spacing="{StaticResource Space.S}">
                        <TextBlock Classes="section-title" Text="{TemplateBinding Heading}" />
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.S}">
                          <Button Name="PART_New" Classes="toolbar" Content="{TemplateBinding NewLabel}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="0,1,0,0"
                            Padding="{StaticResource Pad.S}"
                            IsVisible="{TemplateBinding HelpText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <TextBlock Classes="help" Text="{TemplateBinding HelpText}" />
                    </Border>
                    <ListBox Name="PART_Rows"
                             ItemsSource="{TemplateBinding Rows}"
                             Background="{StaticResource Brush.Surface}"
                             SelectionMode="Single">
                      <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel />
                        </ItemsPanelTemplate>
                      </ListBox.ItemsPanel>
                    </ListBox>
                  </DockPanel>
                </Border>
                <GridSplitter Grid.Column="1" Width="4" Background="{StaticResource Brush.Border}" ResizeDirection="Columns" />
                <Panel Grid.Column="2">
                  <TextBlock Classes="help"
                             Margin="{StaticResource Pad.L}"
                             Text="{TemplateBinding EmptyDetailText}"
                             IsVisible="{TemplateBinding HasDetail, Converter={x:Static BoolConverters.Not}}" />
                  <form:SectionForm Name="PART_Detail"
                                    Screen="{TemplateBinding Detail}"
                                    IsVisible="{TemplateBinding HasDetail}" />
                </Panel>
              </Grid>
            </DockPanel>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <!-- A MasterDetail row: name (or its in-place editor) over the summary, the active box at the end. -->
      <ControlTheme x:Key="{x:Type md:MasterRow}" TargetType="md:MasterRow">
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="PART_Frame" Classes="row">
              <Grid Classes="row-line" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="{StaticResource Space.XS}">
                  <TextBlock Name="PART_Name"
                             Classes="row-name"
                             Text="{TemplateBinding NameText}"
                             IsVisible="{TemplateBinding IsEditing, Converter={x:Static BoolConverters.Not}}" />
                  <TextBox Name="PART_NameEditor" Classes="tile-editor" IsVisible="{TemplateBinding IsEditing}" />
                  <TextBlock Classes="help" Text="{TemplateBinding SummaryText}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <CheckBox Grid.Column="1" Name="PART_Active" Classes="row-active" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:inactive /template/ TextBlock#PART_Name">
          <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type tree:CommandHeader}" TargetType="tree:CommandHeader">
        <Setter Property="Template">
          <ControlTemplate>
            <Border BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="{StaticResource Border.Hairline}"
                    Background="{StaticResource Brush.Surface}"
                    Padding="{StaticResource Pad.M}"
                    Margin="{StaticResource Pad.S}">
              <Panel>
                <TextBlock Classes="help"
                           Text="Select a command to edit its trigger and steps."
                           IsVisible="{TemplateBinding HasCommand, Converter={x:Static BoolConverters.Not}}" />
                <StackPanel Spacing="{StaticResource Space.S}" IsVisible="{TemplateBinding HasCommand}">
                  <TextBlock Classes="section-title" Text="{TemplateBinding NameText}" />
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.M}">
                    <TextBlock Classes="field-label header-label" Text="Trigger" VerticalAlignment="Center" />
                    <ComboBox Name="PART_TriggerKind" Classes="field-editor" />
                    <ComboBox Name="PART_WheelDirection" Classes="field-editor" IsVisible="{TemplateBinding IsWheelKind}" />
                    <Button Name="PART_PickGesture" Classes="toolbar" IsVisible="{TemplateBinding IsGestureKind}">
                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.S}">
                        <glyph:GestureGlyph Classes="row-glyph" Points="{TemplateBinding Points}" />
                        <TextBlock Text="{TemplateBinding TriggerText}" VerticalAlignment="Center" />
                        <TextBlock Classes="help" Text="Change…" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <TextBlock Classes="help"
                               Text="{TemplateBinding TriggerHint}"
                               VerticalAlignment="Center"
                               IsVisible="{TemplateBinding TriggerHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                  <!-- F1 combinations (Joel, 2026-10-09): the buttons, then the keys (Ctrl / Alt / Shift / Win, Opt and Cmd on a Mac), then when they must go down. -->
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.M}">
                    <TextBlock Classes="field-label header-label" Text="While holding" VerticalAlignment="Center" />
                    <CheckBox Name="PART_HoldStroke" Classes="toggle-option" Content="Stroke button" />
                    <CheckBox Name="PART_HoldLeft" Classes="toggle-option" Content="Left" />
                    <CheckBox Name="PART_HoldRight" Classes="toggle-option" Content="Right" />
                    <CheckBox Name="PART_HoldMiddle" Classes="toggle-option" Content="Middle" />
                    <CheckBox Name="PART_HoldX1" Classes="toggle-option" Content="X1" />
                    <CheckBox Name="PART_HoldX2" Classes="toggle-option" Content="X2" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.M}">
                    <TextBlock Classes="field-label header-label" Text="" VerticalAlignment="Center" />
                    <CheckBox Name="PART_KeyControl" Classes="toggle-option" />
                    <CheckBox Name="PART_KeyAlt" Classes="toggle-option" />
                    <CheckBox Name="PART_KeyShift" Classes="toggle-option" />
                    <CheckBox Name="PART_KeyMeta" Classes="toggle-option" />
                    <ComboBox Name="PART_Capture" Classes="field-editor" IsVisible="{TemplateBinding HasHoldMembers}" />
                  </StackPanel>
                  <!-- A combination the rules refuse waits as a draft (Joel, 2026-10-09): what is wrong and how to fix it. Below the boxes, so they never move under the pointer. -->
                  <Border Classes="warning-note" IsVisible="{TemplateBinding DraftNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Name="PART_DraftNote" Classes="error" Text="{TemplateBinding DraftNote}" />
                  </Border>
                  <TextBlock Classes="help"
                             Text="{TemplateBinding AnchorWarning}"
                             TextWrapping="Wrap"
                             IsVisible="{TemplateBinding AnchorWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <TextBlock Classes="help"
                             Text="{TemplateBinding TriggerNote}"
                             TextWrapping="Wrap"
                             IsVisible="{TemplateBinding TriggerNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.M}" IsVisible="{TemplateBinding HasCategories}">
                    <TextBlock Classes="field-label header-label" Text="Category" VerticalAlignment="Center" />
                    <ComboBox Name="PART_Category" Classes="field-editor" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.M}">
                    <TextBlock Classes="field-label header-label" Text="Use on" VerticalAlignment="Center" />
                    <CheckBox Name="PART_UseOnWindows" Classes="toggle-option" Content="Windows" />
                    <CheckBox Name="PART_UseOnMac" Classes="toggle-option" Content="macOS" />
                    <TextBlock Classes="help"
                               Text="{TemplateBinding UseOnNote}"
                               VerticalAlignment="Center"
                               IsVisible="{TemplateBinding UseOnNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                  <StackPanel Spacing="{StaticResource Space.S}" IsVisible="{TemplateBinding VersionText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Classes="help" Text="{TemplateBinding VersionText}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.S}">
                      <Button Name="PART_UseConverted" Classes="toolbar" Content="Use the converted original" IsVisible="{TemplateBinding HasOwnVersionHere}" />
                      <Button Name="PART_MarkChecked" Classes="toolbar" Content="Mark as checked" IsVisible="{TemplateBinding CanMarkChecked}" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Panel>
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type steps:StepList}" TargetType="steps:StepList">
        <Setter Property="Template">
          <ControlTemplate>
            <Border BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="{StaticResource Border.Hairline}"
                    Background="{StaticResource Brush.Surface}"
                    Margin="{StaticResource Pad.S}">
              <DockPanel>
                <Border DockPanel.Dock="Top"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="{StaticResource Border.Bottom}"
                        Padding="{StaticResource Pad.S}">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.S}">
                    <TextBlock Classes="section-title" Text="Steps" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Name="PART_New" Classes="toolbar" Content="New step…" IsEnabled="{TemplateBinding HasCommand}" />
                  </StackPanel>
                </Border>
                <Border DockPanel.Dock="Bottom"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="0,1,0,0"
                        Padding="{StaticResource Pad.S}">
                  <TextBlock Classes="help" Text="Steps run top to bottom; drag one to reorder. Duplicate places the copy below it, Paste adds at the bottom. Delete asks nothing; Undo brings it back." />
                </Border>
                <ListBox Name="PART_Rows"
                         ItemsSource="{TemplateBinding Rows}"
                         Background="{StaticResource Brush.Surface}"
                         SelectionMode="Single">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                </ListBox>
              </DockPanel>
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type steps:StepRow}" TargetType="steps:StepRow">
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="PART_Frame" Classes="row">
              <StackPanel>
                <Grid Classes="row-line" ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                  <TextBlock Grid.Column="0" Classes="drag-handle" Text="≡" />
                  <TextBlock Grid.Column="1" Classes="row-index" Text="{TemplateBinding IndexText}" />
                  <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="{StaticResource Space.XS}">
                    <TextBlock Name="PART_Name" Classes="row-name" Text="{TemplateBinding SummaryText}" />
                    <TextBlock Classes="help" Text="{TemplateBinding TypeText}" />
                  </StackPanel>
                  <TextBlock Grid.Column="3"
                             Classes="platform-marker"
                             Text="{TemplateBinding MarkerText}"
                             IsVisible="{TemplateBinding HasMarker}"
                             VerticalAlignment="Center" />
                  <CheckBox Grid.Column="4" Name="PART_Active" Classes="row-active" VerticalAlignment="Center" />
                </Grid>
                <Border Classes="step-form" IsVisible="{TemplateBinding IsExpanded}">
                  <ContentPresenter Content="{TemplateBinding Form}" />
                </Border>
              </StackPanel>
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:inactive /template/ TextBlock#PART_Name">
          <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        </Style>
        <Style Selector="^:dragging /template/ Border#PART_Frame">
          <Setter Property="Opacity" Value="{StaticResource Opacity.Dragging}" />
        </Style>
        <!-- The frame's thickness never changes, only its colour, so marking a drop target cannot shift the list. -->
        <Style Selector="^:drop-target /template/ Border#PART_Frame">
          <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type picker:StepTypePicker}" TargetType="picker:StepTypePicker">
        <Setter Property="Template">
          <ControlTemplate>
            <Border Padding="{StaticResource Pad.S}" Background="{StaticResource Brush.Surface}">
              <ItemsControl ItemsSource="{TemplateBinding Entries}" />
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type gpicker:GesturePicker}" TargetType="gpicker:GesturePicker">
        <Setter Property="Background" Value="{StaticResource Brush.Background}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{TemplateBinding Background}">
              <DockPanel Classes="dialog">
                <StackPanel DockPanel.Dock="Bottom" Classes="dialog-buttons">
                  <Button Name="PART_NoGesture" Classes="toolbar" Content="No Gesture" />
                  <Button Name="PART_NewGesture" Classes="toolbar" Content="New Gesture…" />
                  <Button Name="PART_Cancel" Classes="toolbar" Content="Cancel" IsCancel="True" />
                  <Button Name="PART_Ok" Classes="toolbar" Content="OK" IsDefault="True" IsEnabled="{TemplateBinding HasSelection}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Classes="section-title" Text="Select Gesture" />
                <TextBlock DockPanel.Dock="Top" Classes="help" Text="Pick the gesture that fires this command; double-click also picks. No Gesture leaves the command trigger-less, New Gesture… draws one first." />
                <ListBox Name="PART_Tiles"
                         ItemsSource="{TemplateBinding TileControls}"
                         Background="{StaticResource Brush.Surface}"
                         SelectionMode="Single"
                         Margin="0,8,0,0">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                </ListBox>
              </DockPanel>
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type dialog:FormDialog}" TargetType="dialog:FormDialog">
        <Setter Property="Background" Value="{StaticResource Brush.Background}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{TemplateBinding Background}">
              <DockPanel Classes="dialog">
                <StackPanel DockPanel.Dock="Bottom" Classes="dialog-buttons">
                  <Button Name="PART_Cancel" Classes="toolbar" Content="Cancel" IsCancel="True" />
                  <Button Name="PART_Confirm" Classes="toolbar" Content="{TemplateBinding ConfirmLabel}" IsDefault="True" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Top"
                           Classes="note"
                           Text="{TemplateBinding Message}"
                           TextWrapping="Wrap"
                           IsVisible="{TemplateBinding HasMessage}" />
                <form:SectionForm Screen="{TemplateBinding Screen}" IsVisible="{TemplateBinding HasScreen}" />
              </DockPanel>
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Standard editors and text roles used inside the components, keyed by class. -->
  <Style Selector="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
    <Setter Property="FontSize" Value="{StaticResource Font.M}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
  </Style>
  <Style Selector="TextBlock.section-title">
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="{StaticResource Font.L}" />
  </Style>
  <Style Selector="TextBlock.field-label">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.help">
    <Setter Property="FontSize" Value="{StaticResource Font.S}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.note">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
  </Style>
  <Style Selector="TextBlock.column-header">
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="{StaticResource Font.S}" />
  </Style>
  <Style Selector="TextBlock.cell">
    <Setter Property="FontSize" Value="{StaticResource Font.S}" />
    <Setter Property="Padding" Value="{StaticResource Row.Padding}" />
  </Style>
  <Style Selector="Grid.list-row">
    <Setter Property="MinHeight" Value="{StaticResource Row.ControlSize}" />
  </Style>
  <Style Selector="ComboBox.field-editor, TextBox.field-editor, NumericUpDown.field-editor">
    <Setter Property="MinWidth" Value="{StaticResource Editor.MinWidth}" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
  </Style>
  <Style Selector="TextBox.field-editor.wide">
    <Setter Property="MinWidth" Value="{StaticResource Editor.WideMinWidth}" />
  </Style>
  <!-- A multi-line text field: grows with its text up to MaxHeight, then scrolls; wrapping and Enter are the renderer's. -->
  <Style Selector="TextBox.field-editor.multiline">
    <Setter Property="MinHeight" Value="{StaticResource Editor.MultilineMinHeight}" />
    <Setter Property="MaxHeight" Value="{StaticResource Editor.MultilineMaxHeight}" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
  </Style>
  <!-- A pattern field (the identification form): text box, magnifier, Use Regex on one line, as SP.net's App Definition.
       The row's editor fills its column, so the text box stretches and never pushes the line over the label. -->
  <Style Selector="form|FieldRow.stretch-editor /template/ ContentPresenter#PART_Editor">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Grid.pattern-line > :is(Control).pattern-finder">
    <Setter Property="Margin" Value="{StaticResource Pad.S}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Grid.pattern-line > CheckBox.pattern-regex">
    <Setter Property="Margin" Value="8,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- A button and its status text on one form line (Options › Sync). -->
  <Style Selector="DockPanel.field-line > Button">
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>
  <Style Selector="NumericUpDown.channel">
    <Setter Property="Width" Value="130" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="RadioButton.button-radio">
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>
  <Style Selector="CheckBox.toggle-option">
    <Setter Property="Margin" Value="0,0,16,0" />
  </Style>
  <Style Selector="Button.toolbar">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="{StaticResource Border.Hairline}" />
    <Setter Property="Background" Value="{StaticResource Brush.Background}" />
    <Setter Property="Padding" Value="{StaticResource Pad.S}" />
  </Style>
  <Style Selector="StackPanel.list-filter">
    <Setter Property="Spacing" Value="{StaticResource Space.S}" />
  </Style>
  <Style Selector="ListBox > ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <!--
    Scroll bars sit beside the content, never over it (Joel, 2026-10-09): Fluent's auto-hiding bar draws over the right
    edge and widens on hover, and on the Commands tab it covered every row's active check box. With auto-hide off the
    bar gets its own column whenever the content scrolls. Set on the scroll viewer itself and as the attached value
    the list and text box templates bind to. ScrollBarLayoutTests holds it.
  -->
  <Style Selector="ScrollViewer">
    <Setter Property="AllowAutoHide" Value="False" />
  </Style>
  <Style Selector="ListBox, TextBox">
    <Setter Property="ScrollViewer.AllowAutoHide" Value="False" />
  </Style>
  <Style Selector="TabControl.sub">
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="TabControl.sub /template/ WrapPanel">
    <Setter Property="Background" Value="{StaticResource Brush.Background}" />
  </Style>
  <!-- Gestures tab, training popup and import dialog roles. -->
  <Style Selector="TextBlock.tile-name">
    <Setter Property="FontSize" Value="{StaticResource Font.S}" />
  </Style>
  <Style Selector="TextBox.tile-editor">
    <Setter Property="FontSize" Value="{StaticResource Font.S}" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="{StaticResource Pad.S}" />
  </Style>
  <Style Selector="Border.tile-partner">
    <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Danger}" />
    <Setter Property="BorderThickness" Value="{StaticResource Border.Hairline}" />
    <Setter Property="Padding" Value="{StaticResource Pad.S}" />
  </Style>
  <Style Selector="TextBlock.tile-partner">
    <Setter Property="FontSize" Value="{StaticResource Font.L}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <!-- A note that something is not saved or not valid yet (the command header's trigger draft); holds a TextBlock.error. -->
  <Style Selector="Border.warning-note">
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Danger}" />
    <Setter Property="BorderThickness" Value="{StaticResource Border.Hairline}" />
    <Setter Property="Padding" Value="{StaticResource Pad.S}" />
  </Style>
  <Style Selector="DockPanel.dialog">
    <Setter Property="Margin" Value="{StaticResource Pad.L}" />
  </Style>
  <Style Selector="StackPanel.dialog-buttons">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Spacing" Value="{StaticResource Space.M}" />
    <Setter Property="Margin" Value="0,8,0,0" />
  </Style>
  <Style Selector="StackPanel.dialog-row, Grid.dialog-row">
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style Selector="StackPanel.dialog-row">
    <Setter Property="Spacing" Value="{StaticResource Space.M}" />
  </Style>
  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="{StaticResource Font.M}" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="12,4" />
  </Style>
  <!-- The colour picker's own tabs (its flyout, class nopadding) keep their theme's padding: the rule above made them 8 px taller than their background. -->
  <Style Selector="FlyoutPresenter.nopadding TabItem">
    <Setter Property="Padding" Value="6,0" />
  </Style>
  <!-- Commands tab roles: tree rows, step rows, the type picker. -->
  <Style Selector="TextBlock.group-name">
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.row-name">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.header-label">
    <Setter Property="MinWidth" Value="{StaticResource Header.LabelWidth}" />
  </Style>
  <Style Selector="Border.category-tag">
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="{StaticResource Border.Hairline}" />
    <Setter Property="Padding" Value="{StaticResource Pad.Tag}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.category-tag">
    <Setter Property="FontSize" Value="{StaticResource Font.S}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
  </Style>
  <Style Selector="TextBlock.platform-marker">
    <Setter Property="FontSize" Value="{StaticResource Font.S}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
    <Setter Property="Margin" Value="8,0" />
  </Style>
  <Style Selector="Button.expander">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Width" Value="{StaticResource Row.ControlSize}" />
    <Setter Property="Height" Value="{StaticResource Row.ControlSize}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{StaticResource Brush.Background}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="{StaticResource Border.Hairline}" />
  </Style>
  <!-- List rows: the one place their frame, spacing and control sizes are set (tokens Row.*). -->
  <Style Selector="Border.row">
    <Setter Property="Background" Value="{StaticResource Brush.HitTest}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="{StaticResource Border.Bottom}" />
  </Style>
  <Style Selector="Grid.row-line">
    <Setter Property="Margin" Value="{StaticResource Row.Padding}" />
    <Setter Property="MinHeight" Value="{StaticResource Row.ControlSize}" />
  </Style>
  <Style Selector="Grid.row-line.indented">
    <Setter Property="Margin" Value="{StaticResource Row.IndentedPadding}" />
  </Style>
  <Style Selector="CheckBox.row-active">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="{StaticResource Row.ControlSize}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="8,0,0,0" />
  </Style>
  <Style Selector="Border.trigger-badge">
    <Setter Property="Width" Value="{StaticResource Row.GlyphSize}" />
    <Setter Property="Height" Value="{StaticResource Row.GlyphSize}" />
    <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="{StaticResource Border.Hairline}" />
  </Style>
  <!-- One word per line (CommandRow.BadgeText) in small type; the template's down-only Viewbox shrinks a word too wide for the tile instead of breaking it (TriggerBadgeTests). -->
  <Style Selector="TextBlock.trigger-badge">
    <Setter Property="FontSize" Value="{StaticResource Font.XS}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.drag-handle, TextBlock.row-index">
    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.row-index">
    <Setter Property="FontSize" Value="{StaticResource Font.S}" />
  </Style>
  <Style Selector="Border.step-form">
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Background" Value="{StaticResource Brush.Background}" />
    <Setter Property="Padding" Value="{StaticResource Pad.S}" />
  </Style>
  <Style Selector="TextBlock.picker-category">
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="{StaticResource Font.S}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
    <Setter Property="Margin" Value="0,8,0,4" />
  </Style>
  <Style Selector="Button.picker-type">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="MinWidth" Value="200" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="{StaticResource Border.Hairline}" />
    <Setter Property="Background" Value="{StaticResource Brush.Background}" />
    <Setter Property="Padding" Value="{StaticResource Pad.S}" />
  </Style>
</Styles>
