<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="using:Avalonia.Controls.Converters"
        xmlns:form="using:Augram.App.Components.SectionForm"
        xmlns:text="using:Augram.App.Components.TextPanel"
        xmlns:hk="using:Augram.App.Components.HotkeyCapture"
        xmlns:wf="using:Augram.App.Components.WindowFinder">
  <!--
    The glass look's forms, text and standard controls (plan 0006 step 4; visual reference
    design/mockups/augram-glass-theme.html, its .frow, .opt-title, .btn, .input, .select, .num, .segm, .switch, .box,
    .slider-field, .info and .link rules). Included by Default.axaml right after the Wireframe theme, so its ControlThemes
    and styles win over Wireframe's. Text sizes, weights and colours are not here: they are the text roles in Text.axaml.
    - forms: SectionForm, SectionView (the title above its card, decision 12), FieldRow (rows split by a faint divider),
      TextPanel, and the field editors' classes;
    - the standard controls app-wide: Button (and the primary button: class primary, or IsDefault), ToggleButton, TextBox,
      ComboBox and its dropdown, NumericUpDown, CheckBox, the switch (CheckBox.field-editor, decision 11), the segmented
      ButtonRadioField (RadioButton.button-radio), Slider, ScrollBar, ToolTip, ContextMenu and MenuItem, flyouts and the
      colour field's swatch button;
    - the hotkey capture box, its modifier toggle and the window finder's magnifier.
    Every colour is a DynamicResource of the per-variant tokens (Tokens.axaml, plus the few below), every corner a Radius.*
    token, so Light, Dark and the corner rounding setting apply while the window is open.
  -->
  <Styles.Resources>
    <ResourceDictionary>
      <!-- The tokens again: this file's setters are resolved while it loads. -->
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Augram/Themes/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <!--
        Tokens only this file uses. Layer.Popup: tooltips, menus, dropdowns and flyouts float in popups with no window
        glass behind them, so their fill is opaque, a step lighter (whiter) than a panel on the page. Slider.*: the dark
        theme keeps the platform slider (a solid accent thumb on a thin track), the light one a thicker light track and a
        white thumb, with a soft shadow, ringed around an accent dot (plan 0006 step 4).
      -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="Layer.Popup" Color="#2C2B31" />
          <x:Double x:Key="Slider.TrackHeight">4</x:Double>
          <x:Double x:Key="Slider.ThumbDot">16</x:Double>
          <x:Double x:Key="Slider.ThumbRing">0</x:Double>
          <BoxShadows x:Key="Slider.ThumbShadow">0 0 0 0 #00000000</BoxShadows>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="Layer.Popup" Color="#FCFCFD" />
          <x:Double x:Key="Slider.TrackHeight">6</x:Double>
          <x:Double x:Key="Slider.ThumbDot">7</x:Double>
          <x:Double x:Key="Slider.ThumbRing">1</x:Double>
          <BoxShadows x:Key="Slider.ThumbShadow">0 1 3 0 #4D000000</BoxShadows>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- The height text fields, dropdowns and number fields grow from (Fluent's 32 made every form row tall). -->
      <x:Double x:Key="Editor.Height">28</x:Double>
      <!-- A form column stops growing here in a wide window, centred (the mockup's Options column is 800; 960 leaves the gallery's
           560 to 760 px dialogs and headers room at the default window size). -->
      <x:Double x:Key="Form.MaxWidth">960</x:Double>
      <!-- A form row: the mockup's .frow (padding, minimum height). -->
      <Thickness x:Key="Form.RowPadding">14,6</Thickness>
      <x:Double x:Key="Form.RowMinHeight">44</x:Double>
      <!-- The one padding of a button, a text field and a dropdown, so they line up on a form line. -->
      <Thickness x:Key="Control.Padding">11,5</Thickness>
      <Thickness x:Key="Input.Padding">10,5</Thickness>

      <!-- The selected segment of a segmented control sits a little raised (the mockup's .segm button[aria-checked]), in both themes. -->
      <BoxShadows x:Key="Segment.Shadow">0 1 2 0 #2E000000</BoxShadows>

      <conv:CornerRadiusFilterConverter x:Key="Forms.LeftCorners" Filter="TopLeft, BottomLeft" />
      <conv:CornerRadiusFilterConverter x:Key="Forms.RightCorners" Filter="TopRight, BottomRight" />

      <!-- Forms (decision 12): the section's title on the page, its rows in a card below it. -->
      <ControlTheme x:Key="{x:Type form:SectionForm}" TargetType="form:SectionForm">
        <Setter Property="Template">
          <ControlTemplate>
            <ScrollViewer>
              <ItemsControl Name="PART_Sections" ItemsSource="{TemplateBinding Sections}" Margin="12,8,12,12" MaxWidth="{StaticResource Form.MaxWidth}" />
            </ScrollViewer>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type form:SectionView}" TargetType="form:SectionView">
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Template">
          <ControlTemplate>
            <StackPanel>
              <!-- The description is an (i) after the title, its text in the tooltip (Joel, 2026-10-09). -->
              <StackPanel Name="PART_Heading"
                          Orientation="Horizontal"
                          Margin="4,4,4,8"
                          IsVisible="{TemplateBinding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Classes="section-heading" Text="{TemplateBinding Title}" />
                <TextBlock Classes="help-icon" ToolTip.Tip="{TemplateBinding Help}" IsVisible="{TemplateBinding HasHelp}" />
              </StackPanel>
              <!-- A panel: a step lighter than the page, a faint edge and a faint highlight along its top (decision 1). -->
              <Panel>
                <Border Name="PART_Card"
                        Background="{DynamicResource Layer.Panel}"
                        BorderBrush="{DynamicResource Layer.Edge}"
                        BorderThickness="{StaticResource Border.Hairline}"
                        CornerRadius="{DynamicResource Radius.Panel}">
                  <ItemsControl ItemsSource="{TemplateBinding Rows}" />
                </Border>
                <Border Name="PART_CardTop"
                        BorderBrush="{DynamicResource Layer.EdgeTop}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="{DynamicResource Radius.Panel}"
                        IsHitTestVisible="False" />
              </Panel>
            </StackPanel>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <!-- A form row: label and its (i) in the label column, the accessory, the editor. Rows are split by a faint line, the first has none. -->
      <ControlTheme x:Key="{x:Type form:FieldRow}" TargetType="form:FieldRow">
        <Setter Property="BorderBrush" Value="{DynamicResource Layer.Divider}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="{StaticResource Form.RowPadding}" />
        <Setter Property="MinHeight" Value="{StaticResource Form.RowMinHeight}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
              <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="{StaticResource Form.LabelColumn}" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- The help is an (i) after the label, its text in the tooltip (Joel, 2026-10-09: the rows were tall with text).
                     A label too long for its column wraps inside it instead of running under the editor. -->
                <Grid Grid.Column="0" ColumnDefinitions="*,Auto" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Grid.Column="0" Classes="field-label" Text="{TemplateBinding Label}" TextWrapping="Wrap" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Classes="help-icon" ToolTip.Tip="{TemplateBinding Help}" IsVisible="{TemplateBinding HasHelp}" />
                </Grid>
                <!-- The field's accessory (a window finder's magnifier) before the editor; no room taken without one. -->
                <ContentPresenter Grid.Column="1"
                                  Content="{TemplateBinding Accessory}"
                                  IsVisible="{TemplateBinding HasAccessory}"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center" />
                <ContentPresenter Grid.Column="2"
                                  Name="PART_Editor"
                                  Content="{TemplateBinding Editor}"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center" />
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:nth-child(1)">
          <Setter Property="BorderThickness" Value="0" />
        </Style>
      </ControlTheme>

      <!-- A text screen: its text in a panel. -->
      <ControlTheme x:Key="{x:Type text:TextPanel}" TargetType="text:TextPanel">
        <Setter Property="Template">
          <ControlTemplate>
            <Border Margin="12,8,12,12"
                    VerticalAlignment="Top"
                    Background="{DynamicResource Layer.Panel}"
                    BorderBrush="{DynamicResource Layer.Edge}"
                    BorderThickness="{StaticResource Border.Hairline}"
                    CornerRadius="{DynamicResource Radius.Panel}"
                    Padding="{StaticResource Pad.L}">
              <TextBlock Text="{TemplateBinding Text}" TextWrapping="Wrap" />
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <!-- Buttons (the mockup's .btn): a control-layer fill, a faint edge, half the corner rounding. -->
      <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Layer.Control}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Layer.Edge}" />
        <Setter Property="BorderThickness" Value="{StaticResource Border.Hairline}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
        <Setter Property="Padding" Value="{StaticResource Control.Padding}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <ControlTemplate>
            <ContentPresenter Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              RecognizesAccessKey="True"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource Layer.ControlHover}" />
        </Style>
        <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource Layer.Hover}" />
        </Style>
        <Style Selector="^:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="BorderBrush" Value="{DynamicResource Accent.Line}" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.45" />
        </Style>
      </ControlTheme>

      <!-- A toggle button (a list's platform filter, the hotkey's right-hand "R"): a button, accent-tinted while on, as a selected sub-tab. -->
      <ControlTheme x:Key="{x:Type ToggleButton}" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type Button}}">
        <Style Selector="^:checked /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Accent.Line}" />
        </Style>
      </ControlTheme>

      <!-- A check box (the mockup's .box): 16 px, the input fill and a faint ring; checked, the accent fill and a tick in its text colour. -->
      <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="6,0,0,0" />
        <Setter Property="MinHeight" Value="{StaticResource Row.ControlSize}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <ControlTemplate>
            <Grid ColumnDefinitions="Auto,*" Background="{TemplateBinding Background}">
              <Border Name="PART_Box"
                      Width="16"
                      Height="16"
                      VerticalAlignment="Center"
                      CornerRadius="4"
                      Background="{DynamicResource Layer.Input}"
                      BorderBrush="{DynamicResource Text.Faint}"
                      BorderThickness="{StaticResource Border.Hairline}">
                <Panel>
                  <Path Name="PART_Tick"
                        Data="M 0.5,3.5 L 3.25,6.25 L 8.5,0.75"
                        Stroke="{DynamicResource Accent.OnFill}"
                        StrokeThickness="1.75"
                        StrokeLineCap="Round"
                        StrokeJoin="Round"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="False" />
                  <Border Name="PART_Dash"
                          Width="8"
                          Height="2"
                          CornerRadius="1"
                          Background="{DynamicResource Accent.OnFill}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          IsVisible="False" />
                </Panel>
              </Border>
              <ContentPresenter Name="PART_ContentPresenter"
                                Grid.Column="1"
                                Margin="{TemplateBinding Padding}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                RecognizesAccessKey="True"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </Grid>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#PART_Box">
          <Setter Property="BorderBrush" Value="{DynamicResource Text.Muted}" />
        </Style>
        <Style Selector="^:checked /template/ Border#PART_Box, ^:indeterminate /template/ Border#PART_Box">
          <Setter Property="Background" Value="{DynamicResource Accent.Fill}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Accent.Edge}" />
        </Style>
        <Style Selector="^:checked /template/ Path#PART_Tick">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:indeterminate /template/ Border#PART_Dash">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_Box">
          <Setter Property="BorderBrush" Value="{DynamicResource Accent.Line}" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.45" />
        </Style>
      </ControlTheme>

      <!-- A switch (decision 11; the mockup's .switch): a single on/off setting on its own row. The toggle field's editor, CheckBox.field-editor. -->
      <ControlTheme x:Key="SwitchCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8,0,0,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <ControlTemplate>
            <Grid ColumnDefinitions="Auto,*" Background="{TemplateBinding Background}">
              <Border Name="PART_Track"
                      Width="34"
                      Height="20"
                      CornerRadius="10"
                      VerticalAlignment="Center"
                      Background="{DynamicResource Layer.Input}"
                      BorderBrush="{DynamicResource Text.Faint}"
                      BorderThickness="{StaticResource Border.Hairline}">
                <Ellipse Name="PART_Knob"
                         Width="14"
                         Height="14"
                         Margin="2,0,0,0"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         Fill="{DynamicResource Text.Muted}">
                  <Ellipse.Transitions>
                    <Transitions>
                      <ThicknessTransition Property="Margin" Duration="0:0:0.12" />
                    </Transitions>
                  </Ellipse.Transitions>
                </Ellipse>
              </Border>
              <ContentPresenter Name="PART_ContentPresenter"
                                Grid.Column="1"
                                Margin="{TemplateBinding Padding}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                RecognizesAccessKey="True"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </Grid>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#PART_Track">
          <Setter Property="BorderBrush" Value="{DynamicResource Text.Muted}" />
        </Style>
        <Style Selector="^:checked /template/ Border#PART_Track">
          <Setter Property="Background" Value="{DynamicResource Accent.Fill}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Accent.Edge}" />
        </Style>
        <Style Selector="^:checked /template/ Ellipse#PART_Knob">
          <Setter Property="Fill" Value="{DynamicResource Accent.OnFill}" />
          <Setter Property="Margin" Value="16,0,0,0" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_Track">
          <Setter Property="BorderBrush" Value="{DynamicResource Accent.Line}" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.45" />
        </Style>
      </ControlTheme>

      <!--
        A segmented control (the mockup's .segm): a ButtonRadioField's radio buttons, side by side in their WrapPanel,
        drawn as one framed strip. Each button draws its share of the frame: the first its left end, the last its right end,
        a lone one the whole frame. The checked segment is a raised pill inside the strip.
      -->
      <ControlTheme x:Key="SegmentRadioButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
        <Setter Property="Padding" Value="10,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel>
              <Border Name="PART_FrameMiddle"
                      Background="{DynamicResource Layer.Input}"
                      BorderBrush="{DynamicResource Layer.Edge}"
                      BorderThickness="0,1" />
              <Border Name="PART_FrameStart"
                      Background="{DynamicResource Layer.Input}"
                      BorderBrush="{DynamicResource Layer.Edge}"
                      BorderThickness="1,1,0,1"
                      CornerRadius="{TemplateBinding CornerRadius, Converter={StaticResource Forms.LeftCorners}}"
                      IsVisible="False" />
              <Border Name="PART_FrameEnd"
                      Background="{DynamicResource Layer.Input}"
                      BorderBrush="{DynamicResource Layer.Edge}"
                      BorderThickness="0,1,1,1"
                      CornerRadius="{TemplateBinding CornerRadius, Converter={StaticResource Forms.RightCorners}}"
                      IsVisible="False" />
              <Border Name="PART_FrameOnly"
                      Background="{DynamicResource Layer.Input}"
                      BorderBrush="{DynamicResource Layer.Edge}"
                      BorderThickness="{StaticResource Border.Hairline}"
                      CornerRadius="{TemplateBinding CornerRadius}"
                      IsVisible="False" />
              <Border Name="PART_Segment"
                      Margin="2,3,0,3"
                      Background="{TemplateBinding Background}"
                      BorderBrush="Transparent"
                      BorderThickness="{StaticResource Border.Hairline}"
                      CornerRadius="{TemplateBinding CornerRadius}"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter Name="PART_ContentPresenter"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  RecognizesAccessKey="True"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
              </Border>
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:nth-child(1) /template/ Border#PART_FrameMiddle">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:nth-child(1) /template/ Border#PART_FrameStart">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:nth-child(1) /template/ Border#PART_Segment">
          <Setter Property="Margin" Value="3,3,0,3" />
        </Style>
        <Style Selector="^:nth-last-child(1) /template/ Border#PART_FrameMiddle">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:nth-last-child(1) /template/ Border#PART_FrameEnd">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:nth-last-child(1) /template/ Border#PART_Segment">
          <Setter Property="Margin" Value="2,3,3,3" />
        </Style>
        <Style Selector="^:nth-child(1):nth-last-child(1) /template/ Border#PART_FrameStart">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:nth-child(1):nth-last-child(1) /template/ Border#PART_FrameEnd">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:nth-child(1):nth-last-child(1) /template/ Border#PART_FrameOnly">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:nth-child(1):nth-last-child(1) /template/ Border#PART_Segment">
          <Setter Property="Margin" Value="3" />
        </Style>
        <Style Selector="^:pointerover">
          <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        </Style>
        <Style Selector="^:checked">
          <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        </Style>
        <Style Selector="^:checked /template/ Border#PART_Segment">
          <Setter Property="Background" Value="{DynamicResource Layer.SegmentOn}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Layer.Edge}" />
          <Setter Property="BoxShadow" Value="{StaticResource Segment.Shadow}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_Segment">
          <Setter Property="BorderBrush" Value="{DynamicResource Accent.Line}" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.45" />
        </Style>
      </ControlTheme>

      <!-- A number field's spinner (the mockup's .num): the value, then quiet − and + buttons inside the same frame. -->
      <ControlTheme x:Key="Forms.SpinnerButton" TargetType="RepeatButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
        <Setter Property="Width" Value="26" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Template">
          <ControlTemplate>
            <ContentPresenter Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              Content="{TemplateBinding Content}"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center" />
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Background" Value="{DynamicResource Layer.Hover}" />
          <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        </Style>
        <Style Selector="^:pressed">
          <Setter Property="Background" Value="{DynamicResource Layer.Track}" />
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type ButtonSpinner}" TargetType="ButtonSpinner">
        <Setter Property="Background" Value="{DynamicResource Layer.Input}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Layer.Edge}" />
        <Setter Property="BorderThickness" Value="{StaticResource Border.Hairline}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <ControlTemplate>
            <DataValidationErrors>
              <Border Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{TemplateBinding CornerRadius}"
                      ClipToBounds="True">
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <ContentPresenter Name="PART_ContentPresenter"
                                    Grid.Column="0"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                  <RepeatButton Name="PART_DecreaseButton"
                                Grid.Column="1"
                                Theme="{StaticResource Forms.SpinnerButton}"
                                IsVisible="{TemplateBinding ShowButtonSpinner}">
                    <Path Width="9" Height="9" Data="M 0,4.5 L 9,4.5" StrokeThickness="1.5" StrokeLineCap="Round"
                          Stroke="{Binding $parent[RepeatButton].Foreground}" />
                  </RepeatButton>
                  <RepeatButton Name="PART_IncreaseButton"
                                Grid.Column="2"
                                Theme="{StaticResource Forms.SpinnerButton}"
                                IsVisible="{TemplateBinding ShowButtonSpinner}">
                    <Path Width="9" Height="9" Data="M 0,4.5 L 9,4.5 M 4.5,0 L 4.5,9" StrokeThickness="1.5" StrokeLineCap="Round"
                          Stroke="{Binding $parent[RepeatButton].Foreground}" />
                  </RepeatButton>
                </Grid>
              </Border>
            </DataValidationErrors>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <!-- The slider (plan 0006 step 4): the accent fill up to the thumb over a light track; the thumb per theme (Slider.* above). -->
      <ControlTheme x:Key="Forms.SliderTrackButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel Background="Transparent">
              <Border Height="{DynamicResource Slider.TrackHeight}"
                      CornerRadius="3"
                      VerticalAlignment="Center"
                      Background="{TemplateBinding Background}" />
            </Panel>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <ControlTheme x:Key="Forms.SliderThumb" TargetType="Thumb">
        <Setter Property="Template">
          <ControlTemplate>
            <Panel Width="18" Height="18" Background="Transparent">
              <Border CornerRadius="9"
                      Background="{DynamicResource Layer.Thumb}"
                      BorderBrush="{DynamicResource Layer.Edge}"
                      BorderThickness="{StaticResource Border.Hairline}"
                      BoxShadow="{DynamicResource Slider.ThumbShadow}"
                      Opacity="{DynamicResource Slider.ThumbRing}" />
              <Ellipse Width="{DynamicResource Slider.ThumbDot}"
                       Height="{DynamicResource Slider.ThumbDot}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Fill="{DynamicResource Accent.Fill}" />
            </Panel>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type Slider}" TargetType="Slider">
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
          <ControlTemplate>
            <Grid MinHeight="22">
              <Border Name="PART_TrackBackground"
                      Height="{DynamicResource Slider.TrackHeight}"
                      CornerRadius="3"
                      VerticalAlignment="Center"
                      Background="{DynamicResource Layer.Track}" />
              <Track Name="PART_Track"
                     Orientation="Horizontal"
                     Minimum="{TemplateBinding Minimum}"
                     Maximum="{TemplateBinding Maximum}"
                     Value="{TemplateBinding Value, Mode=TwoWay}"
                     IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                <Track.DecreaseButton>
                  <RepeatButton Name="PART_DecreaseButton" Theme="{StaticResource Forms.SliderTrackButton}" Background="{DynamicResource Accent.Fill}" />
                </Track.DecreaseButton>
                <Track.IncreaseButton>
                  <RepeatButton Name="PART_IncreaseButton" Theme="{StaticResource Forms.SliderTrackButton}" Background="Transparent" />
                </Track.IncreaseButton>
                <Thumb Name="thumb" Theme="{StaticResource Forms.SliderThumb}" />
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.4" />
        </Style>
      </ControlTheme>

      <!-- Scroll bars: thin and quiet, a rounded thumb and no arrows. They keep their own column (ScrollBarLayoutTests). -->
      <ControlTheme x:Key="Forms.ScrollThumb" TargetType="Thumb">
        <Setter Property="Background" Value="{DynamicResource Layer.Track}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{TemplateBinding Background}" CornerRadius="3" />
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Background" Value="{DynamicResource Text.Faint}" />
        </Style>
        <Style Selector="^:pressed">
          <Setter Property="Background" Value="{DynamicResource Text.Muted}" />
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="Forms.ScrollPageButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="Transparent" />
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
        <Setter Property="Cursor" Value="Arrow" />
        <Style Selector="^:vertical">
          <Setter Property="Width" Value="10" />
          <Setter Property="Template">
            <ControlTemplate>
              <Track Name="PART_Track"
                     Margin="2"
                     Orientation="Vertical"
                     IsDirectionReversed="True"
                     Minimum="{TemplateBinding Minimum}"
                     Maximum="{TemplateBinding Maximum}"
                     Value="{TemplateBinding Value, Mode=TwoWay}"
                     ViewportSize="{TemplateBinding ViewportSize}">
                <Track.DecreaseButton>
                  <RepeatButton Name="PART_PageUpButton" Theme="{StaticResource Forms.ScrollPageButton}" />
                </Track.DecreaseButton>
                <Track.IncreaseButton>
                  <RepeatButton Name="PART_PageDownButton" Theme="{StaticResource Forms.ScrollPageButton}" />
                </Track.IncreaseButton>
                <Thumb Name="thumb" Theme="{StaticResource Forms.ScrollThumb}" MinHeight="24" />
              </Track>
            </ControlTemplate>
          </Setter>
        </Style>
        <Style Selector="^:horizontal">
          <Setter Property="Height" Value="10" />
          <Setter Property="Template">
            <ControlTemplate>
              <Track Name="PART_Track"
                     Margin="2"
                     Orientation="Horizontal"
                     Minimum="{TemplateBinding Minimum}"
                     Maximum="{TemplateBinding Maximum}"
                     Value="{TemplateBinding Value, Mode=TwoWay}"
                     ViewportSize="{TemplateBinding ViewportSize}">
                <Track.DecreaseButton>
                  <RepeatButton Name="PART_PageUpButton" Theme="{StaticResource Forms.ScrollPageButton}" />
                </Track.DecreaseButton>
                <Track.IncreaseButton>
                  <RepeatButton Name="PART_PageDownButton" Theme="{StaticResource Forms.ScrollPageButton}" />
                </Track.IncreaseButton>
                <Thumb Name="thumb" Theme="{StaticResource Forms.ScrollThumb}" MinWidth="24" />
              </Track>
            </ControlTemplate>
          </Setter>
        </Style>
      </ControlTheme>

      <!-- The hotkey capture field (F5): an input-like field, then its buttons; capturing changes only the frame's colour, so nothing shifts. -->
      <ControlTheme x:Key="{x:Type hk:HotkeyCaptureBox}" TargetType="hk:HotkeyCaptureBox">
        <Setter Property="Template">
          <ControlTemplate>
            <StackPanel Spacing="{StaticResource Space.S}">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.M}">
                <Border Name="PART_Field"
                        MinWidth="{StaticResource Editor.MinWidth}"
                        MinHeight="{StaticResource Editor.Height}"
                        Background="{DynamicResource Layer.Input}"
                        BorderBrush="{DynamicResource Layer.Edge}"
                        BorderThickness="{StaticResource Border.Hairline}"
                        CornerRadius="{DynamicResource Radius.Control}"
                        Padding="{StaticResource Input.Padding}"
                        Cursor="Hand">
                  <TextBlock Name="PART_Text" Classes="body" Text="{TemplateBinding DisplayText}" VerticalAlignment="Center" />
                </Border>
                <Button Name="PART_Capture" Classes="toolbar" Content="Capture" />
                <Button Name="PART_Accept" Classes="toolbar primary" Content="Accept" />
                <Button Name="PART_Clear" Classes="toolbar" Content="Clear" />
              </StackPanel>
              <TextBlock Classes="help" Text="{TemplateBinding StatusText}" IsVisible="{TemplateBinding HasStatus}" />
            </StackPanel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ Button#PART_Accept">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:capturing /template/ Button#PART_Accept">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:capturing /template/ Button#PART_Capture">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:capturing /template/ Border#PART_Field">
          <Setter Property="BorderBrush" Value="{DynamicResource Accent.Line}" />
        </Style>
      </ControlTheme>

      <!-- A modifier's check box with a small "R" toggle beside it: the right-hand key (RAlt, RCtrl). -->
      <ControlTheme x:Key="{x:Type hk:ModifierToggle}" TargetType="hk:ModifierToggle">
        <Setter Property="Template">
          <ControlTemplate>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.M}">
              <CheckBox Name="PART_On" VerticalAlignment="Center" />
              <ToggleButton Name="PART_Right"
                            Content="R"
                            ToolTip.Tip="Right-hand key"
                            VerticalAlignment="Center" />
            </StackPanel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ ToggleButton#PART_Right">
          <Setter Property="Padding" Value="6,1" />
        </Style>
      </ControlTheme>

    </ResourceDictionary>
  </Styles.Resources>

  <!-- ===== The ⓘ's place beside its label (its look is the Secondary text role, Text.axaml). ===== -->
  <Style Selector="TextBlock.help-icon">
    <Setter Property="Margin" Value="6,0,0,0" />
  </Style>
  <!-- A link (the mockup's .link): accent text, no frame; under the pointer, the primary text colour. -->
  <Style Selector="Button.link">
    <Setter Property="Foreground" Value="{DynamicResource Accent.Text}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
  </Style>

  <!-- ===== Standard controls (type styles over Fluent's templates, their states after). ===== -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource Layer.Input}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Layer.Edge}" />
    <Setter Property="BorderThickness" Value="{StaticResource Border.Hairline}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Text.Primary}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Accent.Line}" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource Text.Primary}" />
    <Setter Property="MinHeight" Value="{StaticResource Editor.Height}" />
    <Setter Property="Padding" Value="{StaticResource Input.Padding}" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource Layer.Control}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Layer.Edge}" />
    <Setter Property="BorderThickness" Value="{StaticResource Border.Hairline}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
    <Setter Property="MinHeight" Value="{StaticResource Editor.Height}" />
    <Setter Property="Padding" Value="10,5,6,5" />
    <Setter Property="PlaceholderForeground" Value="{DynamicResource Text.Faint}" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
    <Setter Property="Padding" Value="{StaticResource Input.Padding}" />
  </Style>
  <Style Selector="NumericUpDown">
    <Setter Property="Background" Value="{DynamicResource Layer.Input}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Layer.Edge}" />
    <Setter Property="BorderThickness" Value="{StaticResource Border.Hairline}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
    <Setter Property="MinHeight" Value="{StaticResource Editor.Height}" />
    <Setter Property="Padding" Value="{StaticResource Input.Padding}" />
  </Style>
  <!-- A number field's own text box has no frame or fill of its own: the spinner draws them. -->
  <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <!-- Wireframe's field-editor, channel and toolbar rules set square corners and a fixed grey frame; the same classes here win. -->
  <Style Selector="ComboBox.field-editor, TextBox.field-editor, NumericUpDown.field-editor">
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Layer.Edge}" />
  </Style>
  <Style Selector="NumericUpDown.channel">
    <Setter Property="Width" Value="110" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
  </Style>
  <Style Selector="Button.toolbar, ToggleButton.toolbar">
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
    <Setter Property="Background" Value="{DynamicResource Layer.Control}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Layer.Edge}" />
    <Setter Property="BorderThickness" Value="{StaticResource Border.Hairline}" />
    <Setter Property="Padding" Value="{StaticResource Control.Padding}" />
  </Style>
  <!-- The primary button (the mockup's .btn.primary): the accent fill, its text colour and a thin deeper edge; its text is Body
       like every button's (Text.axaml). A dialog's default button is one. -->
  <Style Selector="Button.primary, Button[IsDefault=True]">
    <Setter Property="Background" Value="{DynamicResource Accent.Fill}" />
    <Setter Property="Foreground" Value="{DynamicResource Accent.OnFill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent.Edge}" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button[IsDefault=True]:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent.Fill}" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter, Button[IsDefault=True]:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent.Fill}" />
    <Setter Property="Opacity" Value="0.8" />
  </Style>

  <!-- Text fields: a hover hint, the accent line while focused; a read-only field's text muted. -->
  <Style Selector="TextBox:pointerover, TextBox:focus">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Layer.Input}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Text.Faint}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Layer.Input}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent.Line}" />
    <Setter Property="BorderThickness" Value="{StaticResource Border.Hairline}" />
  </Style>
  <Style Selector="TextBox:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <Style Selector="TextBox:disabled /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Layer.Input}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Layer.Edge}" />
  </Style>
  <Style Selector="TextBox[IsReadOnly=True]">
    <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
  </Style>
  <!-- A number field's own text box keeps no frame of its own under the pointer or in focus; the number field shows the focus. -->
  <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox:pointerover /template/ Border#PART_BorderElement, NumericUpDown /template/ TextBox#PART_TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="NumericUpDown:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent.Line}" />
  </Style>
  <Style Selector="NumericUpDown:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <!-- Dropdowns (the mockup's .select): a button-like control; the list floats on the popup layer, the chosen item accent-tinted. -->
  <Style Selector="ComboBox:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource Layer.ControlHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Layer.Edge}" />
  </Style>
  <Style Selector="ComboBox:pressed /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource Layer.Hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Layer.Edge}" />
  </Style>
  <Style Selector="ComboBox:focus-visible /template/ Border#HighlightBackground">
    <Setter Property="Background" Value="{DynamicResource Layer.ControlHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent.Line}" />
  </Style>
  <Style Selector="ComboBox:dropdownopen /template/ Border#Background">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent.Line}" />
  </Style>
  <!-- Fluent sets the glyph's colour and the list's frame in its template, which a plain style cannot override; these selectors hold
       a state that is always true while the part shows (enabled; the list open), which can. -->
  <Style Selector="ComboBox:not(:disabled) /template/ PathIcon#DropDownGlyph">
    <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
  </Style>
  <Style Selector="ComboBox:dropdownopen /template/ Border#PopupBorder">
    <Setter Property="Background" Value="{DynamicResource Layer.Popup}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Layer.Edge}" />
    <Setter Property="BorderThickness" Value="{StaticResource Border.Hairline}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Panel}" />
    <Setter Property="Padding" Value="{StaticResource Pad.S}" />
  </Style>
  <Style Selector="ComboBox:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ComboBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Layer.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
  </Style>
  <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ComboBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ComboBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
  </Style>

  <!-- The switch and the segmented control: themes for the classes the field renderers set. -->
  <Style Selector="CheckBox.field-editor">
    <Setter Property="Theme" Value="{StaticResource SwitchCheckBox}" />
  </Style>
  <Style Selector="RadioButton.button-radio">
    <Setter Property="Theme" Value="{StaticResource SegmentRadioButton}" />
    <Setter Property="Margin" Value="0" />
  </Style>
  <!-- A form inside a form (a step's form in the gallery, a dialog shown on a page) takes no margin of its own. -->
  <Style Selector="form|SectionForm form|SectionForm /template/ ItemsControl#PART_Sections">
    <Setter Property="Margin" Value="0" />
  </Style>
  <!-- The pattern line (text box, magnifier, Use Regex): the magnifier is a field-high button, so side margins only, and the text box keeps its height. -->
  <Style Selector="Grid.pattern-line > :is(Control).pattern-finder">
    <Setter Property="Margin" Value="6,0" />
  </Style>
  <Style Selector="TextBox.field-editor.pattern-box">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- Check boxes side by side (Ignore keys, Use on; the mockup's .ck). -->
  <Style Selector="CheckBox.toggle-option">
    <Setter Property="Margin" Value="0,0,14,0" />
  </Style>

  <!-- A check list (the export dialog's selection): the input fill, a faint frame, one box per line. -->
  <Style Selector="Border.check-list">
    <Setter Property="Background" Value="{DynamicResource Layer.Input}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Layer.Edge}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
    <Setter Property="Padding" Value="8,4" />
  </Style>

  <!-- Popups: tooltips, menus and flyouts on the opaque popup layer, readable in both themes. -->
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource Layer.Popup}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Layer.Edge}" />
    <Setter Property="BorderThickness" Value="{StaticResource Border.Hairline}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
    <Setter Property="Padding" Value="10,6" />
  </Style>
  <Style Selector="ContextMenu, MenuFlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource Layer.Popup}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Layer.Edge}" />
    <Setter Property="BorderThickness" Value="{StaticResource Border.Hairline}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Panel}" />
    <Setter Property="Padding" Value="{StaticResource Pad.S}" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
  </Style>
  <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot, MenuItem:selected /template/ Border#PART_LayoutRoot, MenuItem:pressed /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource Layer.Hover}" />
  </Style>
  <Style Selector="MenuItem:pointerover /template/ ContentPresenter#PART_HeaderPresenter, MenuItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
  </Style>
  <Style Selector="ContextMenu Separator, MenuFlyoutPresenter Separator">
    <Setter Property="Background" Value="{DynamicResource Layer.Edge}" />
  </Style>
  <Style Selector="FlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource Layer.Popup}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Layer.Edge}" />
    <Setter Property="BorderThickness" Value="{StaticResource Border.Hairline}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Panel}" />
  </Style>

  <!-- An expander (the import dialog's Warnings): a button-like header over its content on the input layer. -->
  <Style Selector="Expander">
    <Setter Property="Background" Value="{DynamicResource Layer.Input}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Layer.Edge}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
  </Style>
  <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
    <Setter Property="Background" Value="{DynamicResource Layer.Control}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Layer.Edge}" />
    <Setter Property="BorderThickness" Value="{StaticResource Border.Hairline}" />
    <Setter Property="MinHeight" Value="{StaticResource Editor.Height}" />
    <Setter Property="Padding" Value="11,0,4,0" />
  </Style>

  <!-- The colour field's swatch button (Avalonia's ColorPicker, a drop-down button) as a button of this theme. -->
  <Style Selector="ColorPicker">
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
    <Setter Property="Background" Value="{DynamicResource Layer.Control}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Layer.Edge}" />
    <Setter Property="BorderThickness" Value="{StaticResource Border.Hairline}" />
  </Style>
  <Style Selector="ColorPicker /template/ DropDownButton">
    <Setter Property="Background" Value="{DynamicResource Layer.Control}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Layer.Edge}" />
    <Setter Property="BorderThickness" Value="{StaticResource Border.Hairline}" />
  </Style>
  <!-- Its picker (the flyout, class nopadding): the tab strip on the popup layer, a faint line under it, the selected tab's pipe in
       the accent. The picker sets these in its template, so the selectors carry the flyout's class, which a template value yields to. -->
  <Style Selector="FlyoutPresenter.nopadding Border#TabBackgroundBorder">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="FlyoutPresenter.nopadding Border#ContentBackgroundBorder">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Layer.Edge}" />
  </Style>
  <Style Selector="FlyoutPresenter.nopadding TabItem /template/ Border#PART_SelectedPipe">
    <Setter Property="Background" Value="{DynamicResource Accent.Fill}" />
  </Style>
</Styles>
