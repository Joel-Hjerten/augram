<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Semantic tokens (ADR-0002 §5, §5b). Components reference these keys and nothing else; the
    architecture test fails any literal colour under Components/. A theme may override any key.
  -->

  <!--
    The glass look's layers (plan 0006 decision 1), per theme variant; only the Default theme uses them, always as
    DynamicResource so a theme switch applies at once. Each layer is a translucent fill over the window background, so the
    same values work over glass and over solid. Layer.Window is the tint colour: Themes/WindowBackdrop paints it at the
    user's tint over the system backdrop, and opaque when there is none. Values come from the mockup's [data-mode] blocks
    (design/mockups/augram-glass-theme.html).
  -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="Layer.Window">#18171C</Color>
      <!-- The window colour as an opaque brush: what shows where no backdrop is (the gallery's theme pairs). -->
      <SolidColorBrush x:Key="Layer.Solid" Color="#18171C" />
      <SolidColorBrush x:Key="Layer.Page" Color="#0BFFFFFF" />
      <SolidColorBrush x:Key="Layer.Panel" Color="#0EFFFFFF" />
      <SolidColorBrush x:Key="Layer.Control" Color="#14FFFFFF" />
      <SolidColorBrush x:Key="Layer.Hover" Color="#0EFFFFFF" />
      <SolidColorBrush x:Key="Layer.Input" Color="#3D000000" />
      <SolidColorBrush x:Key="Layer.Edge" Color="#12FFFFFF" />
      <SolidColorBrush x:Key="Layer.EdgeTop" Color="#1FFFFFFF" />
      <SolidColorBrush x:Key="Layer.Divider" Color="#11FFFFFF" />
      <SolidColorBrush x:Key="Text.Primary" Color="#F2F1F5" />
      <SolidColorBrush x:Key="Text.Muted" Color="#A3F2F1F5" />
      <SolidColorBrush x:Key="Text.Faint" Color="#61F2F1F5" />
      <SolidColorBrush x:Key="Text.Danger" Color="#FF7A70" />
      <SolidColorBrush x:Key="Text.Ok" Color="#5BD18B" />
      <SolidColorBrush x:Key="Text.Warn" Color="#F5B84A" />
      <!-- A gesture tile or trigger badge; a control under the pointer; a segmented choice's selected segment; a slider. -->
      <SolidColorBrush x:Key="Layer.Tile" Color="#0DFFFFFF" />
      <SolidColorBrush x:Key="Layer.ControlHover" Color="#21FFFFFF" />
      <SolidColorBrush x:Key="Layer.SegmentOn" Color="#24FFFFFF" />
      <SolidColorBrush x:Key="Layer.Track" Color="#29FFFFFF" />
      <SolidColorBrush x:Key="Layer.Thumb" Color="#E9E8EE" />
      <!-- Accent: what a root without Themes/AccentLink shows (tests, the previewer); the running app derives these from the trail colour. -->
      <SolidColorBrush x:Key="Accent.Fill" Color="#F5C542" />
      <SolidColorBrush x:Key="Accent.Soft" Color="#29F5C542" />
      <SolidColorBrush x:Key="Accent.Line" Color="#7AF5C542" />
      <SolidColorBrush x:Key="Accent.Edge" Color="#00000000" />
      <SolidColorBrush x:Key="Accent.Text" Color="#F5C542" />
      <SolidColorBrush x:Key="Accent.OnFill" Color="#17140A" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="Layer.Window">#ECEBF0</Color>
      <SolidColorBrush x:Key="Layer.Solid" Color="#ECEBF0" />
      <SolidColorBrush x:Key="Layer.Page" Color="#6BFFFFFF" />
      <SolidColorBrush x:Key="Layer.Panel" Color="#9EFFFFFF" />
      <SolidColorBrush x:Key="Layer.Control" Color="#C7FFFFFF" />
      <SolidColorBrush x:Key="Layer.Hover" Color="#0D141428" />
      <SolidColorBrush x:Key="Layer.Input" Color="#B8FFFFFF" />
      <SolidColorBrush x:Key="Layer.Edge" Color="#17141428" />
      <SolidColorBrush x:Key="Layer.EdgeTop" Color="#CCFFFFFF" />
      <SolidColorBrush x:Key="Layer.Divider" Color="#12141428" />
      <SolidColorBrush x:Key="Text.Primary" Color="#1D1C22" />
      <SolidColorBrush x:Key="Text.Muted" Color="#A31D1C22" />
      <SolidColorBrush x:Key="Text.Faint" Color="#661D1C22" />
      <SolidColorBrush x:Key="Text.Danger" Color="#D93B30" />
      <SolidColorBrush x:Key="Text.Ok" Color="#1E9E57" />
      <SolidColorBrush x:Key="Text.Warn" Color="#A86A00" />
      <SolidColorBrush x:Key="Layer.Tile" Color="#0A141428" />
      <SolidColorBrush x:Key="Layer.ControlHover" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="Layer.SegmentOn" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="Layer.Track" Color="#21141428" />
      <SolidColorBrush x:Key="Layer.Thumb" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Accent.Fill" Color="#F5C542" />
      <SolidColorBrush x:Key="Accent.Soft" Color="#3DF5C542" />
      <SolidColorBrush x:Key="Accent.Line" Color="#99D09B0B" />
      <SolidColorBrush x:Key="Accent.Edge" Color="#99D09B0B" />
      <SolidColorBrush x:Key="Accent.Text" Color="#967008" />
      <SolidColorBrush x:Key="Accent.OnFill" Color="#17140A" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <!-- The glass look's shapes (plan 0006 decisions 4 and 5): the title bar holding the top-level tabs, and a tab's flare. -->
  <x:Double x:Key="TitleBar.Height">46</x:Double>
  <x:Double x:Key="Tab.Height">36</x:Double>
  <CornerRadius x:Key="Radius.Panel">12</CornerRadius>
  <CornerRadius x:Key="Radius.Page">14</CornerRadius>
  <CornerRadius x:Key="Radius.Tab">10,10,0,0</CornerRadius>
  <CornerRadius x:Key="Radius.Control">6</CornerRadius>

  <!-- Colours -->
  <Color x:Key="Color.Background">#1E1E1E</Color>
  <Color x:Key="Color.Surface">#2A2A2A</Color>
  <Color x:Key="Color.Border">#5A5A5A</Color>
  <Color x:Key="Color.Text">#E6E6E6</Color>
  <Color x:Key="Color.TextMuted">#A0A0A0</Color>
  <Color x:Key="Color.Accent">#6CA0DC</Color>
  <Color x:Key="Color.Danger">#E5484D</Color>

  <SolidColorBrush x:Key="Brush.Background" Color="#1E1E1E" />
  <SolidColorBrush x:Key="Brush.Surface" Color="#2A2A2A" />
  <SolidColorBrush x:Key="Brush.Border" Color="#5A5A5A" />
  <SolidColorBrush x:Key="Brush.Text" Color="#E6E6E6" />
  <SolidColorBrush x:Key="Brush.TextMuted" Color="#A0A0A0" />
  <!-- Gesture pictures: end and start of the stroke's gradient. The running app replaces both with the trail colour and its
       shaded start (Themes/AppearanceLink); these are what a root without it shows. Inactive: GlyphStartMuted to TextMuted. -->
  <SolidColorBrush x:Key="Brush.Glyph" Color="#E6E6E6" />
  <SolidColorBrush x:Key="Brush.GlyphStart" Color="#4A6A92" />
  <SolidColorBrush x:Key="Brush.GlyphStartMuted" Color="#4A4A4A" />
  <SolidColorBrush x:Key="Brush.Accent" Color="#6CA0DC" />
  <SolidColorBrush x:Key="Brush.Danger" Color="#E5484D" />
  <!-- The cleaned shape drawn over the stroke in the shape cleanup preview (Gallery, plan M2 step 10). -->
  <SolidColorBrush x:Key="Brush.Cleaned" Color="#F2C14E" />
  <!-- Invisible but hit-testable: a row's background so a click on its empty part still reaches the row. -->
  <SolidColorBrush x:Key="Brush.HitTest" Color="#00000000" />

  <!-- F1 inspector outline colours by nesting depth (ADR-0002 §5d) -->
  <Color x:Key="Inspector.Depth0">#D32F2F</Color>
  <Color x:Key="Inspector.Depth1">#1976D2</Color>
  <Color x:Key="Inspector.Depth2">#388E3C</Color>
  <Color x:Key="Inspector.Depth3">#F57C00</Color>
  <Color x:Key="Inspector.Label">#FFFFFF</Color>

  <!-- Spacing -->
  <x:Double x:Key="Space.XS">2</x:Double>
  <x:Double x:Key="Space.S">4</x:Double>
  <x:Double x:Key="Space.M">8</x:Double>
  <x:Double x:Key="Space.L">16</x:Double>
  <Thickness x:Key="Pad.S">4</Thickness>
  <Thickness x:Key="Pad.M">8</Thickness>
  <Thickness x:Key="Pad.L">16</Thickness>
  <Thickness x:Key="Border.Hairline">1</Thickness>
  <Thickness x:Key="Border.Strong">2</Thickness>
  <Thickness x:Key="Border.Bottom">0,0,0,1</Thickness>
  <!--
    List rows: one set of metrics for every row of every list (section headers, command rows, step rows,
    item-list rows), so all lists share one line height (Joel, 2026-10-07: the Apps headers were taller
    than Global's because a check box kept the toolkit's 32 px minimum). Rows use the Border.row and
    Grid.row-line classes and never set their own padding; RowMetricsTests enforces it.
  -->
  <Thickness x:Key="Row.Padding">4</Thickness>
  <!-- Row.Padding plus the indent of a command under its section header. -->
  <Thickness x:Key="Row.IndentedPadding">28,4,4,4</Thickness>
  <!-- Row.IndentedPadding one indent further: a command under a hold remap, whose header sits at the command indent. -->
  <Thickness x:Key="Row.NestedPadding">52,4,4,4</Thickness>
  <!-- Height of every control inside a row (expander, active check box) and the row's minimum line height. -->
  <x:Double x:Key="Row.ControlSize">24</x:Double>
  <!-- A gesture glyph or trigger badge inside a row. -->
  <x:Double x:Key="Row.GlyphSize">40</x:Double>
  <!-- A small bordered tag inside a row (a command's category on the Apps tab). -->
  <Thickness x:Key="Pad.Tag">4,0</Thickness>
  <x:Double x:Key="Opacity.Dragging">0.5</x:Double>

  <!-- Type. The Default theme uses these through the text roles in Themes/Default/Text.axaml only. -->
  <FontFamily x:Key="Font.Family">$Default</FontFamily>
  <!-- Diagnostics › Log's lines (the Mono role). -->
  <FontFamily x:Key="Font.Mono">Consolas, Menlo, SF Mono, Cascadia Mono, Courier New</FontFamily>
  <!-- The smallest type: a trigger badge's two words inside a 40 px row tile. -->
  <x:Double x:Key="Font.XS">10</x:Double>
  <x:Double x:Key="Font.S">11</x:Double>
  <x:Double x:Key="Font.M">13</x:Double>
  <x:Double x:Key="Font.L">16</x:Double>

  <!-- Layout -->
  <!-- 180 since plan 0006 (Joel, 2026-10-11): at 220 a two-choice segment ran off the Exclusions form; the longest label fits, and a longer one wraps. -->
  <GridLength x:Key="Form.LabelColumn">180</GridLength>
  <x:Double x:Key="Editor.MinWidth">180</x:Double>
  <!-- A text editor for long values (a repository address). -->
  <x:Double x:Key="Editor.WideMinWidth">420</x:Double>
  <x:Double x:Key="Editor.PatternMinWidth">30</x:Double>
  <!-- A multi-line text editor (a typed-text step): about two lines when short, grows with its text to about eight, then scrolls. -->
  <x:Double x:Key="Editor.MultilineMinHeight">48</x:Double>
  <x:Double x:Key="Editor.MultilineMaxHeight">160</x:Double>
  <!-- A check list field (the export dialog's app groups): about eight lines, then it scrolls. -->
  <x:Double x:Key="Editor.CheckListMaxHeight">220</x:Double>
  <!-- A slider field (plan 0006: Tint, Corner rounding): the slider's length, and room for its value beside it ("100%", "18 px"). -->
  <x:Double x:Key="Editor.SliderWidth">240</x:Double>
  <x:Double x:Key="Editor.SliderValueWidth">44</x:Double>
  <!--
    A colour field's preset swatches (plan 0006 decision 8): round buttons Swatch.Size across, Swatch.Spacing apart. The
    fill sits inside a Swatch.Ring ring (drawn on the selected one only) and a Swatch.RingGap gap, so it is
    Swatch.Size - 2 × (Ring + RingGap) across, 20 px, and its corner radius half of that.
  -->
  <x:Double x:Key="Swatch.Size">28</x:Double>
  <x:Double x:Key="Swatch.Spacing">6</x:Double>
  <Thickness x:Key="Swatch.Ring">2</Thickness>
  <Thickness x:Key="Swatch.RingGap">2</Thickness>
  <CornerRadius x:Key="Swatch.CornerRadius">14</CornerRadius>
  <CornerRadius x:Key="Swatch.FillCornerRadius">10</CornerRadius>
  <!-- The command tree's column on the Commands tab; the splitter beside it lets the user change it. -->
  <GridLength x:Key="Workbench.TreeWidth">380</GridLength>
  <!-- The labels of the command header (Trigger, Category), so their dropdowns line up. -->
  <x:Double x:Key="Header.LabelWidth">72</x:Double>
  <!-- The sync conflict list's fixed columns (item, choice); this machine's and the other machine's versions share the rest. -->
  <GridLength x:Key="SyncConflict.ItemColumn">200</GridLength>
  <GridLength x:Key="SyncConflict.ChoiceColumn">200</GridLength>
</ResourceDictionary>
