<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Semantic tokens (ADR-0002 §5, §5b). Components reference these keys and nothing else; the
    architecture test fails any literal colour under Components/. A theme may override any key.
  -->

  <!-- Colours -->
  <Color x:Key="Color.Background">#1E1E1E</Color>
  <Color x:Key="Color.Surface">#2A2A2A</Color>
  <Color x:Key="Color.Border">#5A5A5A</Color>
  <Color x:Key="Color.Text">#E6E6E6</Color>
  <Color x:Key="Color.TextMuted">#A0A0A0</Color>
  <Color x:Key="Color.Accent">#6CA0DC</Color>
  <Color x:Key="Color.Danger">#E5484D</Color>

  <SolidColorBrush x:Key="Brush.Background" Color="#1E1E1E" />
  <SolidColorBrush x:Key="Brush.Surface" Color="#2A2A2A" />
  <SolidColorBrush x:Key="Brush.Border" Color="#5A5A5A" />
  <SolidColorBrush x:Key="Brush.Text" Color="#E6E6E6" />
  <SolidColorBrush x:Key="Brush.TextMuted" Color="#A0A0A0" />
  <SolidColorBrush x:Key="Brush.Accent" Color="#6CA0DC" />
  <SolidColorBrush x:Key="Brush.Danger" Color="#E5484D" />
  <!-- Invisible but hit-testable: a row's background so a click on its empty part still reaches the row. -->
  <SolidColorBrush x:Key="Brush.HitTest" Color="#00000000" />

  <!-- F1 inspector outline colours by nesting depth (ADR-0002 §5d) -->
  <Color x:Key="Inspector.Depth0">#D32F2F</Color>
  <Color x:Key="Inspector.Depth1">#1976D2</Color>
  <Color x:Key="Inspector.Depth2">#388E3C</Color>
  <Color x:Key="Inspector.Depth3">#F57C00</Color>
  <Color x:Key="Inspector.Label">#FFFFFF</Color>

  <!-- Spacing -->
  <x:Double x:Key="Space.XS">2</x:Double>
  <x:Double x:Key="Space.S">4</x:Double>
  <x:Double x:Key="Space.M">8</x:Double>
  <x:Double x:Key="Space.L">16</x:Double>
  <Thickness x:Key="Pad.S">4</Thickness>
  <Thickness x:Key="Pad.M">8</Thickness>
  <Thickness x:Key="Pad.L">16</Thickness>
  <Thickness x:Key="Border.Hairline">1</Thickness>
  <Thickness x:Key="Border.Strong">2</Thickness>
  <Thickness x:Key="Border.Bottom">0,0,0,1</Thickness>
  <!--
    List rows: one set of metrics for every row of every list (section headers, command rows, step rows,
    item-list rows), so all lists share one line height (Joel, 2026-10-07: the Apps headers were taller
    than Global's because a check box kept the toolkit's 32 px minimum). Rows use the Border.row and
    Grid.row-line classes and never set their own padding; RowMetricsTests enforces it.
  -->
  <Thickness x:Key="Row.Padding">4</Thickness>
  <!-- Row.Padding plus the indent of a command under its section header. -->
  <Thickness x:Key="Row.IndentedPadding">28,4,4,4</Thickness>
  <!-- Height of every control inside a row (expander, active check box) and the row's minimum line height. -->
  <x:Double x:Key="Row.ControlSize">24</x:Double>
  <!-- A gesture glyph or trigger badge inside a row. -->
  <x:Double x:Key="Row.GlyphSize">40</x:Double>
  <!-- A small bordered tag inside a row (a command's category on the Apps tab). -->
  <Thickness x:Key="Pad.Tag">4,0</Thickness>
  <x:Double x:Key="Opacity.Dragging">0.5</x:Double>

  <!-- Type -->
  <FontFamily x:Key="Font.Family">$Default</FontFamily>
  <x:Double x:Key="Font.S">11</x:Double>
  <x:Double x:Key="Font.M">13</x:Double>
  <x:Double x:Key="Font.L">16</x:Double>

  <!-- Layout -->
  <GridLength x:Key="Form.LabelColumn">220</GridLength>
  <x:Double x:Key="Editor.MinWidth">180</x:Double>
  <!-- The command tree's column on the Commands tab; the splitter beside it lets the user change it. -->
  <GridLength x:Key="Workbench.TreeWidth">380</GridLength>
  <!-- The labels of the command header (Trigger, Category), so their dropdowns line up. -->
  <x:Double x:Key="Header.LabelWidth">72</x:Double>
</ResourceDictionary>
