<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <!-- The .exe's own icon (Explorer, pinning). Generated by tools/IconTool from design/app-icon. Windows builds only: the SDK
       can embed resources into the apphost only when building on Windows, and warns (an error here) elsewhere. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <ApplicationIcon>Icons\augram.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Augram.Core/Augram.Core.csproj" />
    <ProjectReference Include="../Augram.Engine/Augram.Engine.csproj" />
    <ProjectReference Include="../Augram.Platform.Windows/Augram.Platform.Windows.csproj" />
    <ProjectReference Include="../Augram.Platform.MacOS/Augram.Platform.MacOS.csproj" />
    <ProjectReference Include="../Augram.Import.StrokesPlus/Augram.Import.StrokesPlus.csproj" />
    <ProjectReference Include="../Augram.Sync.Git/Augram.Sync.Git.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Augram.App.Tests" />
  </ItemGroup>
  <!-- The build channel (Directory.Build.props, AugramChannel) as [AssemblyMetadata("AugramChannel", …)]; Hosting/AppInfo reads it. -->
  <ItemGroup>
    <AssemblyMetadata Include="AugramChannel" Value="$(AugramChannel)" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
</Project>
