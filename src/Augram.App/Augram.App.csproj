<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- The program is Augram.exe (Augram inside Augram.app), not the project's name (Joel, 2026-10-11: Task Manager showed
         "Augram.App"). Namespaces stay Augram.App; resources are avares://Augram/…; start at login rewrites an entry naming the
         old Augram.App.exe at the next start (StartupPolicy: outdated → register). -->
    <AssemblyName>Augram</AssemblyName>
    <Product>Augram</Product>
    <AssemblyTitle>Augram</AssemblyTitle>
  </PropertyGroup>
  <!-- The .exe's own icon (Explorer, pinning). Generated by tools/IconTool from design/app-icon. Windows builds only: the SDK
       can embed resources into the apphost only when building on Windows, and warns (an error here) elsewhere. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <ApplicationIcon>Icons\augram.ico</ApplicationIcon>
  </PropertyGroup>
  <!-- Packaged builds (scripts/package.mjs, docs/release.md): the script publishes self-contained and ReadyToRun for one
       runtime and Velopack packs the folder. Never trimmed: Avalonia's XAML loader and the DI container reach types by
       reflection that a trimmer cannot see, and a trimmed build fails at run time, not at build time. The XML doc files
       exist for IDE0005 at build (Directory.Build.props), not for the installed app. -->
  <PropertyGroup>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Augram.Core/Augram.Core.csproj" />
    <ProjectReference Include="../Augram.Engine/Augram.Engine.csproj" />
    <ProjectReference Include="../Augram.Platform.Windows/Augram.Platform.Windows.csproj" />
    <ProjectReference Include="../Augram.Platform.MacOS/Augram.Platform.MacOS.csproj" />
    <ProjectReference Include="../Augram.Import.StrokesPlus/Augram.Import.StrokesPlus.csproj" />
    <ProjectReference Include="../Augram.Sync.Git/Augram.Sync.Git.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Augram.App.Tests" />
    <!-- tools/UiShots builds the app headless from the composition root to render screenshots. -->
    <InternalsVisibleTo Include="UiShots" />
  </ItemGroup>
  <!-- The build channel (Directory.Build.props, AugramChannel) as [AssemblyMetadata("AugramChannel", …)]; Hosting/AppInfo reads it. -->
  <ItemGroup>
    <AssemblyMetadata Include="AugramChannel" Value="$(AugramChannel)" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <!-- The Mac icon, also for a development build's Dock icon (MacDock.SetIcon). -->
    <AvaloniaResource Include="Icons/augram.icns" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Velopack" />
  </ItemGroup>
</Project>
