<Project Sdk="Microsoft.NET.Sdk">

  <!-- Throwaway spike (plan 0001, M0 step 3). Deliberately self-contained: it must build
       standalone with `dotnet build src/Augram.Spike2` whether or not the solution-level
       Directory.Build.props / Directory.Packages.props exist yet. Deleted at M1. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <IsPackable>false</IsPackable>
    <AssemblyName>Augram.Spike2</AssemblyName>
    <RootNamespace>Augram.Spike2</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="SharpHook" Version="7.1.3" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.3" />
  </ItemGroup>

</Project>
