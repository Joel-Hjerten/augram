{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/memory-sync.mjs\" start 2>/dev/null || true",
            "timeout": 45,
            "statusMessage": "Syncing memory + checking origin..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/memory-sync.mjs\" prompt 2>/dev/null || true",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/memory-sync.mjs\" stop 2>/dev/null || true",
            "timeout": 45
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Read(~/AppData/Roaming/Augram/**)",
      "Edit(~/AppData/Roaming/Augram/**)",
      "Read(~/AppData/Local/Augram/**)",
      "Read(~/Library/Application Support/Augram/**)",
      "Edit(~/Library/Application Support/Augram/**)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(dotnet:*)",
      "Bash(node:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(sed -n:*)",
      "Bash(awk:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(cut:*)",
      "Bash(tr:*)",
      "Bash(diff:*)",
      "Bash(cd:*)",
      "Bash(pwd)",
      "Bash(test:*)",
      "Bash(src/Augram.App/bin/*)",
      "Bash(./src/Augram.App/bin/*)",
      "Bash(open src/Augram.App/bin/*)",
      "Bash(open /Applications/Augram.app)",
      "Bash(pkill -f Augram.App*)",
      "PowerShell(git:*)",
      "PowerShell(gh:*)",
      "PowerShell(dotnet:*)",
      "PowerShell(node:*)",
      "PowerShell(Get-Process*)",
      "PowerShell(Get-ChildItem*)",
      "PowerShell(Get-Content*)",
      "PowerShell(Get-WinEvent*)",
      "PowerShell(Get-Date*)",
      "PowerShell(Test-Path*)",
      "PowerShell(Select-String*)",
      "PowerShell(Select-Object*)",
      "PowerShell(Start-Sleep*)",
      "PowerShell(Start-Process -FilePath src\\Augram.App\\bin\\*)",
      "PowerShell(Start-Process -FilePath .\\src\\Augram.App\\bin\\*)",
      "PowerShell(Start-Process -FilePath \"$env:LOCALAPPDATA\\Augram\\Augram.exe\")",
      "PowerShell(Start-Process -FilePath artifacts\\releases\\win-x64\\Augram-win-Setup.exe*)",
      "PowerShell(Stop-Process*)"
    ],
    "ask": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git reset --hard:*)",
      "PowerShell(Remove-Item -Recurse:*)"
    ]
  }
}
