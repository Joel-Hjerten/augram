<Project>
  <!-- Central package management (ADR-0002 §7): every version lives here, csproj files carry none. -->
  <ItemGroup Label="Runtime">
    <PackageVersion Include="SharpHook" Version="7.1.3" />
    <PackageVersion Include="Avalonia" Version="11.3.22" />
    <PackageVersion Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <!-- The colour picker behind a colour field's swatch (Joel, 2026-10-08); same version as Avalonia, same MIT project. -->
    <PackageVersion Include="Avalonia.Controls.ColorPicker" Version="11.3.22" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Win32.SystemEvents" Version="10.0.3" />
    <!-- Installer and updater (docs/release.md). Keep in step with the vpk tool in .config/dotnet-tools.json. -->
    <PackageVersion Include="Velopack" Version="1.2.161" />
  </ItemGroup>
  <ItemGroup Label="Tools">
    <!-- tools/IconTool: the same SkiaSharp Avalonia 11.3 brings in, so nothing new is downloaded. -->
    <PackageVersion Include="SkiaSharp" Version="2.88.9" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="11.3.22" />
    <!-- tools/UiShots: headless rendering to PNG, the same package the XUnit one wraps. -->
    <PackageVersion Include="Avalonia.Headless" Version="11.3.22" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="GitHubActionsTestLogger" Version="3.0.5" />
  </ItemGroup>
</Project>
