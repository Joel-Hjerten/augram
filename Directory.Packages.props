<Project>
  <!-- Central package management (ADR-0002 §7): every version lives here, csproj files carry none. -->
  <ItemGroup Label="Runtime">
    <PackageVersion Include="SharpHook" Version="7.1.3" />
    <PackageVersion Include="Avalonia" Version="11.3.22" />
    <PackageVersion Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="11.3.22" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
